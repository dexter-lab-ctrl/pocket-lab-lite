  n12 [label="Passkey rename or revoke"]; n12 -> m12; m12 [label="DELETE /api/lite/identity/passkeys/{credential_id} → backend execution"];
  n13 [label="Enterprise membership"]; n13 -> m13; m13 [label="GET /api/lite/enterprise/identity → backend execution"];
  n14 [label="Rules revision lifecycle"]; n14 -> m14; m14 [label="POST /api/lite/enterprise/rules/activations → backend execution"];
  n15 [label="Rules analysis and simulation"]; n15 -> m15; m15 [label="GET /api/lite/enterprise/rules/analysis → backend execution"];
  n16 [label="Rules approval review"]; n16 -> m16; m16 [label="GET /api/lite/enterprise/rules/approvals → backend execution"];
  n17 [label="Rules temporary exception"]; n17 -> m17; m17 [label="GET /api/lite/enterprise/rules/exceptions → backend execution"];
