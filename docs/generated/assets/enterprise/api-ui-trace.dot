digraph flow {
  graph [rankdir="LR", bgcolor="transparent", label="API-to-UI trace", labelloc="t"];
  node [shape="box", style="rounded,filled", fillcolor="#f8fafc"];
  n0 [label="Add Device"]; n0 -> m0; m0 [label="POST /api/lite/fleet/agent/bootstrap-blocked → backend execution"];
  n1 [label="Restart Agent"]; n1 -> m1; m1 [label="POST /api/lite/fleet/devices/{node_id}/restart-agent → backend execution"];
  n2 [label="Install App"]; n2 -> m2; m2 [label="GET /api/lite/apps/lifecycle → backend execution"];
  n3 [label="Open App"]; n3 -> m3; m3 [label="GET /api/lite/apps/lifecycle → backend execution"];
  n4 [label="Run Security Check"]; n4 -> m4; m4 [label="POST /api/lite/security/check → backend execution"];
  n5 [label="Back Up"]; n5 -> m5; m5 [label="POST /api/lite/recovery/backup → backend execution"];
  n6 [label="Preview Restore"]; n6 -> m6; m6 [label="GET /api/lite/apps/photoprism/storage-preview → backend execution"];
  n7 [label="Restore"]; n7 -> m7; m7 [label="POST /api/lite/apps/{app_id}/restore/preview → backend execution"];
  n8 [label="Remove Old Device"]; n8 -> m8; m8 [label="POST /api/lite/catalog/remove → backend execution"];
}
