digraph device_onboarding {
  graph [
    rankdir=LR,
    splines=ortho,
    nodesep=0.42,
    ranksep=0.72,
    pad=0.25,
    margin=0,
    bgcolor="#101827",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="Device onboarding lifecycle",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="11",
    style="rounded,filled",
    color="#94a3b8",
    fontcolor="#f8fafc",
    penwidth="1.2",
    margin="0.16,0.10"
  ];
  edge [
    fontname="Arial",
    fontsize="9",
    color="#94a3b8",
    fontcolor="#cbd5e1",
    arrowsize="0.75",
    penwidth="1.1"
  ];
  "invite" [label="Create invite", shape="box", fillcolor="#312e81", tooltip="Create invite. Backend-owned invite creation and fail-closed identity checks lead to agent and supervisor heartbeats.", URL="../../generated/production/devices/", target="_top"];
  "audit" [label="Audit evidence", shape="parallelogram", fillcolor="#831843", tooltip="Audit evidence. Backend-owned invite creation and fail-closed identity checks lead to agent and supervisor heartbeats.", URL="../../generated/development/redaction-coverage/", target="_top"];
  "command" [label="Copy bootstrap command", shape="parallelogram", fillcolor="#831843", tooltip="Copy bootstrap command. Backend-owned invite creation and fail-closed identity checks lead to agent and supervisor heartbeats.", URL="../../generated/development/bootstrap-stages/", target="_top"];
  "guard" [label="Identity guard", shape="diamond", fillcolor="#7c2d12", tooltip="Identity guard. Backend-owned invite creation and fail-closed identity checks lead to agent and supervisor heartbeats.", URL="../../generated/development/reason-codes/", target="_top", style="filled"];
  "env" [label="Safe env write", shape="box", fillcolor="#312e81", tooltip="Safe env write. Backend-owned invite creation and fail-closed identity checks lead to agent and supervisor heartbeats.", URL="../../generated/development/configuration-reference/", target="_top"];
  "agent" [label="Node agent", shape="component", fillcolor="#14532d", tooltip="Node agent. Backend-owned invite creation and fail-closed identity checks lead to agent and supervisor heartbeats.", URL="../../generated/development/service-catalog/", target="_top"];
  "supervisor" [label="Agent supervisor", shape="component", fillcolor="#14532d", tooltip="Agent supervisor. Backend-owned invite creation and fail-closed identity checks lead to agent and supervisor heartbeats.", URL="../../generated/development/service-catalog/", target="_top"];
  "heartbeat" [label="Heartbeats in Devices", shape="parallelogram", fillcolor="#831843", tooltip="Heartbeats in Devices. Backend-owned invite creation and fail-closed identity checks lead to agent and supervisor heartbeats.", URL="../../generated/production/devices/", target="_top"];
  "invite" -> "audit" [label="record", tooltip="record"];
  "audit" -> "command" [label="approved artifact", tooltip="approved artifact"];
  "command" -> "guard" [label="consume invite", tooltip="consume invite"];
  "guard" -> "env" [label="match", tooltip="match"];
  "guard" -> "audit" [label="mismatch / blocked", tooltip="mismatch / blocked"];
  "env" -> "agent" [label="start", tooltip="start"];
  "env" -> "supervisor" [label="start", tooltip="start"];
  "agent" -> "heartbeat" [label="publish", tooltip="publish"];
  "supervisor" -> "agent" [label="recover", tooltip="recover"];
}
