digraph prepared_projection_flow {
  graph [
    rankdir=LR,
    splines=ortho,
    compound=true,
    newrank=true,
    outputorder=edgesfirst,
    nodesep=0.42,
    ranksep=0.72,
    pad=0.25,
    margin=0,
    bgcolor="#101827",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="Prepared projection flow",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="11",
    style="rounded,filled",
    color="#94a3b8",
    fontcolor="#f8fafc",
    penwidth="1.2",
    margin="0.16,0.10"
  ];
  edge [
    fontname="Arial",
    fontsize="9",
    color="#94a3b8",
    fontcolor="#cbd5e1",
    arrowsize="0.75",
    penwidth="1.1"
  ];
  "admission" [label="Bounded admission", shape="diamond", fillcolor="#7c2d12", tooltip="Bounded admission. Canonical events are admitted through bounded schedulers and promoted atomically to prepared SQLite reads.", URL="../../generated/development/projection-catalog/", target="_top", style="filled"];
  "api" [label="FastAPI safe read", shape="box", fillcolor="#312e81", tooltip="FastAPI safe read. Canonical events are admitted through bounded schedulers and promoted atomically to prepared SQLite reads.", URL="../../reference/api/lite-api/", target="_top"];
  "canonical" [label="Canonical hash check", shape="diamond", fillcolor="#7c2d12", tooltip="Canonical hash check. Canonical events are admitted through bounded schedulers and promoted atomically to prepared SQLite reads.", URL="../../generated/development/projection-catalog/", target="_top", style="filled"];
  "event" [label="Compact domain event", shape="parallelogram", fillcolor="#831843", tooltip="Compact domain event. Canonical events are admitted through bounded schedulers and promoted atomically to prepared SQLite reads.", URL="../../generated/development/lite-events/", target="_top"];
  "prepared" [label="Prepared SQLite projection", shape="cylinder", fillcolor="#78350f", tooltip="Prepared SQLite projection. Canonical events are admitted through bounded schedulers and promoted atomically to prepared SQLite reads.", URL="../../generated/development/lite-sqlite-schema/", target="_top"];
  "scheduler" [label="Projection scheduler", shape="component", fillcolor="#14532d", tooltip="Projection scheduler. Canonical events are admitted through bounded schedulers and promoted atomically to prepared SQLite reads.", URL="../../generated/development/projection-catalog/", target="_top"];
  "ui" [label="TanStack Query / safe snapshot", shape="box", fillcolor="#0c4a6e", tooltip="TanStack Query / safe snapshot. Canonical events are admitted through bounded schedulers and promoted atomically to prepared SQLite reads.", URL="../../generated/development/projection-catalog/", target="_top"];
  "admission" -> "scheduler" [label="accepted/coalesced", tooltip="accepted/coalesced"];
  "api" -> "ui" [label="revision + ETag", tooltip="revision + ETag"];
  "canonical" -> "api" [label="unchanged", tooltip="unchanged"];
  "canonical" -> "prepared" [label="semantic change", tooltip="semantic change"];
  "event" -> "admission" [label="signal", tooltip="signal"];
  "prepared" -> "api" [label="bounded read", tooltip="bounded read"];
  "scheduler" -> "canonical" [label="rebuild affected domain", tooltip="rebuild affected domain"];
}
