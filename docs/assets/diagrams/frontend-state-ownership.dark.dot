digraph frontend_state_ownership {
  graph [
    rankdir=TB,
    splines=ortho,
    compound=true,
    newrank=true,
    outputorder=edgesfirst,
    nodesep=0.42,
    ranksep=0.72,
    pad=0.25,
    margin=0,
    bgcolor="#101827",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="Frontend state ownership",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="11",
    style="rounded,filled",
    color="#94a3b8",
    fontcolor="#f8fafc",
    penwidth="1.2",
    margin="0.16,0.10"
  ];
  edge [
    fontname="Arial",
    fontsize="9",
    color="#94a3b8",
    fontcolor="#cbd5e1",
    arrowsize="0.75",
    penwidth="1.1"
  ];
  subgraph cluster_client {
    label="Client-only state";
    style="rounded,dashed";
    color="#94a3b8";
    fontcolor="#cbd5e1";
    penwidth="1.0";
    margin="16";
    "xstate" [label="XState workflow machines", shape="component", fillcolor="#14532d", tooltip="XState workflow machines. TanStack Query owns server synchronization, Dexie owns durable offline snapshots, Zustand owns lightweight UI preferences, and XState owns bounded workflows; selectors merge them into truthful Lite screens.", URL="../../generated/development/recovery-state-machine/", target="_top"];
    "zustand" [label="Zustand UI preferences", shape="component", fillcolor="#14532d", tooltip="Zustand UI preferences. TanStack Query owns server synchronization, Dexie owns durable offline snapshots, Zustand owns lightweight UI preferences, and XState owns bounded workflows; selectors merge them into truthful Lite screens.", URL="../../generated/development/ui-state-catalog/", target="_top"];
  }
  subgraph cluster_offline {
    label="Offline durability";
    style="rounded,dashed";
    color="#94a3b8";
    fontcolor="#cbd5e1";
    penwidth="1.0";
    margin="16";
    "dexie" [label="Dexie offline snapshots", shape="cylinder", fillcolor="#78350f", tooltip="Dexie offline snapshots. TanStack Query owns server synchronization, Dexie owns durable offline snapshots, Zustand owns lightweight UI preferences, and XState owns bounded workflows; selectors merge them into truthful Lite screens.", URL="../../generated/development/ui-state-catalog/", target="_top"];
  }
  subgraph cluster_presentation {
    label="Presentation contract";
    style="rounded,dashed";
    color="#94a3b8";
    fontcolor="#cbd5e1";
    penwidth="1.0";
    margin="16";
    "screen" [label="Home / Devices / Apps / Safety / Recovery", shape="box", fillcolor="#0c4a6e", tooltip="Home / Devices / Apps / Safety / Recovery. TanStack Query owns server synchronization, Dexie owns durable offline snapshots, Zustand owns lightweight UI preferences, and XState owns bounded workflows; selectors merge them into truthful Lite screens.", URL="../../generated/production/tabs/", target="_top"];
    "selector" [label="Canonical screen selector", shape="diamond", fillcolor="#7c2d12", tooltip="Canonical screen selector. TanStack Query owns server synchronization, Dexie owns durable offline snapshots, Zustand owns lightweight UI preferences, and XState owns bounded workflows; selectors merge them into truthful Lite screens.", URL="../../generated/development/ui-state-catalog/", target="_top", style="filled"];
  }
  subgraph cluster_server {
    label="Server-synchronized state";
    style="rounded,dashed";
    color="#94a3b8";
    fontcolor="#cbd5e1";
    penwidth="1.0";
    margin="16";
    "api" [label="FastAPI prepared projections", shape="box", fillcolor="#312e81", tooltip="FastAPI prepared projections. TanStack Query owns server synchronization, Dexie owns durable offline snapshots, Zustand owns lightweight UI preferences, and XState owns bounded workflows; selectors merge them into truthful Lite screens.", URL="../../reference/api/lite-api/", target="_top"];
    "query" [label="TanStack Query cache", shape="cylinder", fillcolor="#78350f", tooltip="TanStack Query cache. TanStack Query owns server synchronization, Dexie owns durable offline snapshots, Zustand owns lightweight UI preferences, and XState owns bounded workflows; selectors merge them into truthful Lite screens.", URL="../../generated/development/frontend-api-usage/", target="_top"];
  }
  "api" -> "query" [label="fetch + revision", tooltip="fetch + revision"];
  "dexie" -> "selector" [label="offline fallback", tooltip="offline fallback"];
  "query" -> "dexie" [label="persist safe snapshot", tooltip="persist safe snapshot"];
  "query" -> "selector" [label="fresh server state", tooltip="fresh server state"];
  "selector" -> "screen" [label="one truthful presentation", tooltip="one truthful presentation"];
  "xstate" -> "selector" [label="workflow progress", tooltip="workflow progress"];
  "zustand" -> "selector" [label="view preferences", tooltip="view preferences"];
}
