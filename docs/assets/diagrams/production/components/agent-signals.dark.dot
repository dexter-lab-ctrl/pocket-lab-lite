digraph component_agent_signals {
  graph [
    rankdir="TB",
    splines="spline",
    compound="true",
    newrank="true",
    nodesep="0.30",
    ranksep="0.52",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#0f172a",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="Heartbeat, telemetry, and health publishers connections",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#94a3b8",
    fontcolor="#f8fafc",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#94a3b8",
    fontcolor="#cbd5e1",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_durable-state" {
    label="Durable-state boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "device-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Enrollment and device<BR/>lifecycle state</B></FONT><BR/><FONT POINT-SIZE="9">Retains enrolled devices across<BR/>connectivity loss and separates<BR/>durable enrollment, current state,...</FONT><BR/><FONT POINT-SIZE="8"><I>SQLite</I></FONT><BR/><FONT POINT-SIZE="7.5">Database</FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Enrollment and device lifecycle state. Retains enrolled devices across connectivity loss and separates durable enrollment, current state, health, supervisor state, and recovery history.", URL="../../../../generated/production/architecture/components/device-state/", target="_top"];
  }
  subgraph "cluster_managed-device" {
    label="Managed-device boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "agent-signals" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Heartbeat, telemetry,<BR/>and health publishers</B></FONT><BR/><FONT POINT-SIZE="9">Publish fresh runtime signals used<BR/>to derive Online, Offline, Stale,<BR/>Agent stopped, and Remote access...</FONT><BR/><FONT POINT-SIZE="8"><I>Node agent</I></FONT><BR/><FONT POINT-SIZE="7.5">Event</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled,bold", fillcolor="#831843", color="#f8fafc", fontcolor="#f8fafc", penwidth="2.3", tooltip="Heartbeat, telemetry, and health publishers. Publish fresh runtime signals used to derive Online, Offline, Stale, Agent stopped, and Remote access not ready states.", URL="../../../../generated/production/architecture/components/agent-signals/", target="_top"];
    "node-agent" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Lite node agent</B></FONT><BR/><FONT POINT-SIZE="9">Connects to NATS, publishes<BR/>heartbeat/telemetry/health,<BR/>handles device commands, and...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host or joined<BR/>device</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Lite node agent. Connects to NATS, publishes heartbeat/telemetry/health, handles device commands, and reconnects after outages.", URL="../../../../generated/production/architecture/components/node-agent/", target="_top"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "nats-jetstream" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>NATS / JetStream</B></FONT><BR/><FONT POINT-SIZE="9">Provides the command and event<BR/>backbone with durable delivery; it<BR/>is never contacted directly by the...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host</I></FONT><BR/><FONT POINT-SIZE="7.5">Event</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled", fillcolor="#831843", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="NATS / JetStream. Provides the command and event backbone with durable delivery; it is never contacted directly by the frontend.", URL="../../../../generated/production/architecture/components/nats-jetstream/", target="_top"];
  }
  "node-agent" -> "agent-signals" [label="publishes", tooltip="publishes (NATS)", style="dashed", arrowhead="normal", color="#6ee7b7", fontcolor="#6ee7b7", penwidth="1.15", arrowsize="0.72"];
  "agent-signals" -> "nats-jetstream" [label="heartbeat/telemetry/health", tooltip="heartbeat/telemetry/health (NATS)", style="dashed", arrowhead="normal", color="#6ee7b7", fontcolor="#6ee7b7", penwidth="1.15", arrowsize="0.72"];
  "agent-signals" -> "device-state" [label="updates device truth", tooltip="updates device truth (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
  "state_dependency_0" [label="device_heartbeats", shape="note", style="filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", tooltip="Durable-state dependency"];
  "agent-signals" -> "state_dependency_0" [label="state", style="dotted", color="#60a5fa", fontcolor="#60a5fa"];
  "state_dependency_1" [label="device_health_current", shape="note", style="filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", tooltip="Durable-state dependency"];
  "agent-signals" -> "state_dependency_1" [label="state", style="dotted", color="#60a5fa", fontcolor="#60a5fa"];
}
