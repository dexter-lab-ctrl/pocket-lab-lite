  }
  "lite-api" -> "api-read-surfaces" [label="serves safe reads", tooltip="serves safe reads (Python)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa"];
  "api-read-surfaces" -> "frontend-state" [label="safe summary", tooltip="safe summary (HTTPS)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa"];
  "remote-readiness" -> "api-read-surfaces" [label="readiness summary", tooltip="readiness summary (HTTP)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa"];
  "prepared-state" -> "api-read-surfaces" [label="prepared read", tooltip="prepared read (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa"];
  "state_dependency_0" [label="prepared projections", shape="note", style="filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", tooltip="Durable-state dependency"];
  "api-read-surfaces" -> "state_dependency_0" [label="state", style="dotted", color="#60a5fa", fontcolor="#60a5fa"];
  "state_dependency_1" [label="audit_evidence_index", shape="note", style="filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", tooltip="Durable-state dependency"];
  "api-read-surfaces" -> "state_dependency_1" [label="state", style="dotted", color="#60a5fa", fontcolor="#60a5fa"];
  "additional_dependencies" [label="Additional dependencies (1)", shape="note", style="dashed,filled", fillcolor="#111827", color="#94a3b8", fontcolor="#f8fafc", tooltip="Additional dependencies (1)"];
  "api-read-surfaces" -> "additional_dependencies" [style="dotted", arrowhead="none", color="#cbd5e1"];
}
