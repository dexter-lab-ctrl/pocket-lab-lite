digraph component_recovery_state {
  graph [
    rankdir="TB",
    splines="spline",
    compound="true",
    newrank="true",
    nodesep="0.30",
    ranksep="0.52",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#0f172a",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="Backup, restore, and checkpoint state connections",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#94a3b8",
    fontcolor="#f8fafc",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#94a3b8",
    fontcolor="#cbd5e1",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_durable-state" {
    label="Durable-state boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "recovery-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Backup, restore, and<BR/>checkpoint state</B></FONT><BR/><FONT POINT-SIZE="9">Stores backup manifests, recovery<BR/>operations, current state,<BR/>database backups/restores, and...</FONT><BR/><FONT POINT-SIZE="8">SQLite and<BR/>repository-owned manifests</FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled,bold", fillcolor="#78350f", color="#f8fafc", fontcolor="#f8fafc", penwidth="2.2", tooltip="Backup, restore, and checkpoint state. Stores backup manifests, recovery operations, current state, database backups/restores, and restore checkpoints.", URL="../../../../generated/production/architecture/components/recovery-state/", target="_top"];
    "sqlite" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>SQLite control-plane<BR/>store</B></FONT><BR/><FONT POINT-SIZE="9">Stores canonical Lite lifecycle<BR/>state and prepared projections;<BR/>the frontend never accesses it...</FONT><BR/><FONT POINT-SIZE="8">Server host</FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="SQLite control-plane store. Stores canonical Lite lifecycle state and prepared projections; the frontend never accesses it directly.", URL="../../../../generated/production/architecture/components/sqlite/", target="_top"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "app-recovery-update" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>App backup, restore<BR/>preview, and update...</B></FONT><BR/><FONT POINT-SIZE="9">Coordinates app backup, safe<BR/>restore preview, update<BR/>readiness/apply, verification, and...</FONT><BR/><FONT POINT-SIZE="8">Worker / release<BR/>subprocess</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="App backup, restore preview, and update lifecycle. Coordinates app backup, safe restore preview, update readiness/apply, verification, and rollback gates without browser-owned execution.", URL="../../../../generated/production/architecture/components/app-recovery-update/", target="_top"];
    "backup-engine" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Backup and<BR/>verification engine</B></FONT><BR/><FONT POINT-SIZE="9">Creates and verifies local<BR/>encrypted backups through<BR/>backend/worker-owned operations.</FONT><BR/><FONT POINT-SIZE="8">Recovery worker</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="Backup and verification engine. Creates and verifies local encrypted backups through backend/worker-owned operations.", URL="../../../../generated/production/architecture/components/backup-engine/", target="_top"];
    "restore-preview" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Restore preview and<BR/>confirmed restore</B></FONT><BR/><FONT POINT-SIZE="9">Builds a non-destructive preview,<BR/>requires explicit confirmation,<BR/>creates a checkpoint, applies...</FONT><BR/><FONT POINT-SIZE="8">Recovery worker</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="Restore preview and confirmed restore. Builds a non-destructive preview, requires explicit confirmation, creates a checkpoint, applies restore, and validates health.", URL="../../../../generated/production/architecture/components/restore-preview/", target="_top"];
  }
  "app-recovery-update" -> "recovery-state" [label="stores manifests/operations", tooltip="stores manifests/operations (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa"];
  "recovery-state" -> "sqlite" [label="stored in", tooltip="stored in (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa"];
  "backup-engine" -> "recovery-state" [label="updates backup state", tooltip="updates backup state (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa"];
  "restore-preview" -> "recovery-state" [label="updates restore state", tooltip="updates restore state (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa"];
  "state_dependency_0" [label="backup_manifest_index", shape="note", style="filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", tooltip="Durable-state dependency"];
  "recovery-state" -> "state_dependency_0" [label="state", style="dotted", color="#60a5fa", fontcolor="#60a5fa"];
  "state_dependency_1" [label="recovery_operations", shape="note", style="filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", tooltip="Durable-state dependency"];
  "recovery-state" -> "state_dependency_1" [label="state", style="dotted", color="#60a5fa", fontcolor="#60a5fa"];
}
