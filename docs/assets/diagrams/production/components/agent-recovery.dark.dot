    bgcolor="#0f172a",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="Reconnect watchdog and supervisor recovery connections",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#94a3b8",
    fontcolor="#f8fafc",
    margin="0.12,0.08"
  ];
