digraph component_remote_readiness {
  graph [
    rankdir="TB",
    splines="spline",
    compound="true",
    newrank="true",
    nodesep="0.30",
    ranksep="0.52",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#ffffff",
    fontcolor="#172033",
    fontname="Arial",
    label="Remote-access readiness checks connections",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#64748b",
    fontcolor="#172033",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#64748b",
    fontcolor="#475569",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_control-api" {
    label="Control API boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "api-read-surfaces" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__api-read-surfaces" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Prepared read, health,<BR/>readiness, diagnostics,...</B></FONT><BR/><FONT POINT-SIZE="9">Serves side-effect-free prepared<BR/>projections, health/readiness,...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI process · pocket-api</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e0e7ff", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Prepared read, health, readiness, diagnostics, and evidence APIs. Serves side-effect-free prepared projections, health/readiness, compact diagnostics, and sanitized evidence lookups.", URL="../../../../generated/production/architecture/components/api-read-surfaces/", target="_top", margin="0.10,0.08"];
    "remote-readiness" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__remote-readiness" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="7"><B>CURRENT COMPONENT</B></FONT><BR/><FONT POINT-SIZE="13"><B>Remote-access readiness<BR/>checks</B></FONT><BR/><FONT POINT-SIZE="9">Combines tailscaled state, Tailnet<BR/>IPv4, NATS listener reachability,...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI read surface · pocket-api</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled,bold", fillcolor="#fef2f2", color="#172033", fontcolor="#172033", penwidth="2.5", tooltip="Remote-access readiness checks. Combines tailscaled state, Tailnet IPv4, NATS listener reachability, agent/supervisor status, and safe guidance.", URL="../../../../generated/production/architecture/components/remote-readiness/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_server-host" {
    label="Server-host boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "nats-listeners" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__nats-listeners" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Primary and secondary<BR/>NATS listeners</B></FONT><BR/><FONT POINT-SIZE="9">Exposes local and verified<BR/>Tailnet-reachable NATS listeners...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host · pocket-nats</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#cffafe", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Primary and secondary NATS listeners. Exposes local and verified Tailnet-reachable NATS listeners for agents without hardcoding credentials or addresses.", URL="../../../../generated/production/architecture/components/nats-listeners/", target="_top", margin="0.10,0.08"];
    "tailscaled" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__tailscaled" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>tailscaled daemon</B></FONT><BR/><FONT POINT-SIZE="9">Owns Tailscale networking; startup<BR/>scripts may detect/start it safely...</FONT><BR/><FONT POINT-SIZE="8"><I>Android/Termux server host · startup scripts</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="tailscaled daemon. Owns Tailscale networking; startup scripts may detect/start it safely while read APIs remain side-effect-free.", URL="../../../../generated/production/architecture/components/tailscaled/", target="_top", margin="0.10,0.08"];
  }
  "remote-readiness" -> "api-read-surfaces" [label="readiness summary", tooltip="readiness summary (HTTP)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb", penwidth="1.15", arrowsize="0.72"];
  "tailscaled" -> "remote-readiness" [label="daemon status", tooltip="daemon status (Local status)", style="dashed", arrowhead="normal", color="#047857", fontcolor="#047857", penwidth="1.15", arrowsize="0.72"];
  "nats-listeners" -> "remote-readiness" [label="listener reachability", tooltip="listener reachability (TCP)", style="dashed", arrowhead="normal", color="#047857", fontcolor="#047857", penwidth="1.15", arrowsize="0.72"];
}
