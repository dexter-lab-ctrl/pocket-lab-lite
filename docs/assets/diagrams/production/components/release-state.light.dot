digraph component_release_state {
  graph [
    rankdir="TB",
    splines="spline",
    compound="true",
    newrank="true",
    nodesep="0.30",
    ranksep="0.52",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#ffffff",
    fontcolor="#172033",
    fontname="Arial",
    label="Installed release and runtime state connections",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#64748b",
    fontcolor="#172033",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#64748b",
    fontcolor="#475569",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_durable-state" {
    label="Durable-state boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "release-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Installed release and<BR/>runtime state</B></FONT><BR/><FONT POINT-SIZE="9">Stores installed-release identity<BR/>and release-runtime projection for<BR/>truthful comparison, staging,...</FONT><BR/><FONT POINT-SIZE="8"><I>SQLite</I></FONT><BR/><FONT POINT-SIZE="7.5">Database</FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled,bold", fillcolor="#fef3c7", color="#172033", fontcolor="#172033", penwidth="2.3", tooltip="Installed release and runtime state. Stores installed-release identity and release-runtime projection for truthful comparison, staging, apply, rollback, and last-known-good state.", URL="../../../../generated/production/architecture/components/release-state/", target="_top"];
    "sqlite" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>SQLite control-plane<BR/>store</B></FONT><BR/><FONT POINT-SIZE="9">Stores canonical Lite lifecycle<BR/>state and prepared projections;<BR/>the frontend never accesses it...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host</I></FONT><BR/><FONT POINT-SIZE="7.5">Database</FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="SQLite control-plane store. Stores canonical Lite lifecycle state and prepared projections; the frontend never accesses it directly.", URL="../../../../generated/production/architecture/components/sqlite/", target="_top"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "release-subprocess" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Release subprocess</B></FONT><BR/><FONT POINT-SIZE="9">Owns network, download,<BR/>verification, staging, apply, and<BR/>rollback work outside the FastAPI...</FONT><BR/><FONT POINT-SIZE="8"><I>Dedicated subprocess</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Release subprocess. Owns network, download, verification, staging, apply, and rollback work outside the FastAPI event loop.", URL="../../../../generated/production/architecture/components/release-subprocess/", target="_top"];
  }
  subgraph "cluster_server-host" {
    label="Server-host boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "post-switch-health" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Post-switch health<BR/>validation</B></FONT><BR/><FONT POINT-SIZE="9">Validates Caddy/FastAPI/PWA health<BR/>after promotion before declaring<BR/>the release current.</FONT><BR/><FONT POINT-SIZE="8"><I>Release subprocess against<BR/>local services</I></FONT><BR/><FONT POINT-SIZE="7.5">Decision</FONT></TD></TR></TABLE>>, shape="diamond", style="rounded,filled", fillcolor="#fef2f2", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Post-switch health validation. Validates Caddy/FastAPI/PWA health after promotion before declaring the release current.", URL="../../../../generated/production/architecture/components/post-switch-health/", target="_top"];
  }
  "post-switch-health" -> "release-state" [label="mark current/failed", tooltip="mark current/failed (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "release-state" -> "sqlite" [label="stored in", tooltip="stored in (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "release-subprocess" -> "release-state" [label="updates release state", tooltip="updates release state (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "state_dependency_0" [label="lite_installed_release_identity", shape="note", style="filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", tooltip="Durable-state dependency"];
  "release-state" -> "state_dependency_0" [label="state", style="dotted", color="#2563eb", fontcolor="#2563eb"];
  "state_dependency_1" [label="release_runtime_projection", shape="note", style="filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", tooltip="Durable-state dependency"];
  "release-state" -> "state_dependency_1" [label="state", style="dotted", color="#2563eb", fontcolor="#2563eb"];
}
