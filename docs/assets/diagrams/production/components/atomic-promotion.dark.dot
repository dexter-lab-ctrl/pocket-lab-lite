    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "release-subprocess" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__release-subprocess" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Release subprocess</B></FONT><BR/><FONT POINT-SIZE="9">Owns network, download,<BR/>verification, staging, apply, and...</FONT><BR/><FONT POINT-SIZE="8"><I>Dedicated subprocess · pocket-worker</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Release subprocess. Owns network, download, verification, staging, apply, and rollback work outside the FastAPI event loop.", URL="../../../../generated/production/architecture/components/release-subprocess/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_server-host" {
    label="Server-host boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "atomic-promotion" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__atomic-promotion" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="7"><B>CURRENT COMPONENT</B></FONT><BR/><FONT POINT-SIZE="13"><B>Atomic PWA promotion</B></FONT><BR/><FONT POINT-SIZE="9">Promotes a verified staged PWA<BR/>atomically and keeps the previous...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host · release subprocess</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled,bold", fillcolor="#14532d", color="#f8fafc", fontcolor="#f8fafc", penwidth="2.5", tooltip="Atomic PWA promotion. Promotes a verified staged PWA atomically and keeps the previous release available for rollback.", URL="../../../../generated/production/architecture/components/atomic-promotion/", target="_top", margin="0.10,0.08"];
    "caddy" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__caddy" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Caddy same-origin proxy</B></FONT><BR/><FONT POINT-SIZE="9">Serves the PWA and routes<BR/>/api/lite/* and managed app paths...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host · PM2</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#4c1d95", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Caddy same-origin proxy. Serves the PWA and routes /api/lite/* and managed app paths without exposing backend secrets.", URL="../../../../generated/production/architecture/components/caddy/", target="_top", margin="0.10,0.08"];
    "last-known-good" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__last-known-good" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Last-known-good state and<BR/>rollback</B></FONT><BR/><FONT POINT-SIZE="9">Records the verified prior release<BR/>and restores it atomically when...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host / release<BR/>subprocess · release subprocess</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Last-known-good state and rollback. Records the verified prior release and restores it atomically when post-switch validation fails.", URL="../../../../generated/production/architecture/components/last-known-good/", target="_top", margin="0.10,0.08"];
    "post-switch-health" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__post-switch-health" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Post-switch health<BR/>validation</B></FONT><BR/><FONT POINT-SIZE="9">Validates Caddy/FastAPI/PWA health<BR/>after promotion before declaring...</FONT><BR/><FONT POINT-SIZE="8"><I>Release subprocess against<BR/>local services · release subprocess</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#7f1d1d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Post-switch health validation. Validates Caddy/FastAPI/PWA health after promotion before declaring the release current.", URL="../../../../generated/production/architecture/components/post-switch-health/", target="_top", margin="0.10,0.08"];
  }
  "atomic-promotion" -> "caddy" [label="serves active PWA", tooltip="serves active PWA (Filesystem/HTTP)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "atomic-promotion" -> "post-switch-health" [label="validate switched release", tooltip="validate switched release (HTTP)", style="dashed", arrowhead="normal", color="#6ee7b7", fontcolor="#6ee7b7", penwidth="1.15", arrowsize="0.72"];
