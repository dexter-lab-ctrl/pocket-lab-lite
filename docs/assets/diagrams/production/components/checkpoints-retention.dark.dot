digraph component_checkpoints_retention {
  graph [
    rankdir="TB",
    splines="spline",
    compound="true",
    newrank="true",
    nodesep="0.30",
    ranksep="0.52",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#0f172a",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="Checkpoints and retention policy connections",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#94a3b8",
    fontcolor="#f8fafc",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#94a3b8",
    fontcolor="#cbd5e1",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "checkpoints-retention" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Checkpoints and<BR/>retention policy</B></FONT><BR/><FONT POINT-SIZE="9">Creates pre-change checkpoints and<BR/>applies explicit bounded retention<BR/>without silently deleting current...</FONT><BR/><FONT POINT-SIZE="8"><I>Recovery worker</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled,bold", fillcolor="#14532d", color="#f8fafc", fontcolor="#f8fafc", penwidth="2.3", tooltip="Checkpoints and retention policy. Creates pre-change checkpoints and applies explicit bounded retention without silently deleting current state.", URL="../../../../generated/production/architecture/components/checkpoints-retention/", target="_top"];
    "restore-preview" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Restore preview and<BR/>confirmed restore</B></FONT><BR/><FONT POINT-SIZE="9">Builds a non-destructive preview,<BR/>requires explicit confirmation,<BR/>creates a checkpoint, applies...</FONT><BR/><FONT POINT-SIZE="8"><I>Recovery worker</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Restore preview and confirmed restore. Builds a non-destructive preview, requires explicit confirmation, creates a checkpoint, applies restore, and validates health.", URL="../../../../generated/production/architecture/components/restore-preview/", target="_top"];
    "retirement-database-recovery" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Explicit retirement<BR/>and database recovery</B></FONT><BR/><FONT POINT-SIZE="9">Requires assessment and<BR/>confirmation for device retirement<BR/>and provides verified database...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI / worker</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Explicit retirement and database recovery. Requires assessment and confirmation for device retirement and provides verified database backup/preview/restore without coupling command cleanup to device deletion.", URL="../../../../generated/production/architecture/components/retirement-database-recovery/", target="_top"];
  }
  "restore-preview" -> "checkpoints-retention" [label="creates checkpoint before apply", tooltip="creates checkpoint before apply (NATS)", style="dashed", arrowhead="vee", color="#fbbf24", fontcolor="#fbbf24", penwidth="1.15", arrowsize="0.72"];
  "checkpoints-retention" -> "retirement-database-recovery" [label="provides recovery point", tooltip="provides recovery point (SQLite)", style="dashed", arrowhead="vee", color="#fbbf24", fontcolor="#fbbf24", penwidth="1.15", arrowsize="0.72"];
  "state_dependency_0" [label="recovery_operations", shape="note", style="filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", tooltip="Durable-state dependency"];
  "checkpoints-retention" -> "state_dependency_0" [label="state", style="dotted", color="#60a5fa", fontcolor="#60a5fa"];
}
