digraph component_command_lifecycle {
  graph [
    rankdir="TB",
    splines="spline",
    compound="true",
    newrank="true",
    nodesep="0.30",
    ranksep="0.52",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#0f172a",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="Command admission and lifecycle connections",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#94a3b8",
    fontcolor="#f8fafc",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#94a3b8",
    fontcolor="#cbd5e1",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "command-lifecycle" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Command admission and<BR/>lifecycle</B></FONT><BR/><FONT POINT-SIZE="9">Tracks admission, queued, claimed,<BR/>running, terminal,<BR/>acknowledgement, retry, and...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI and worker</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled,bold", fillcolor="#14532d", color="#f8fafc", fontcolor="#f8fafc", penwidth="2.3", tooltip="Command admission and lifecycle. Tracks admission, queued, claimed, running, terminal, acknowledgement, retry, and dead-letter behavior independently from device lifecycle.", URL="../../../../generated/production/architecture/components/command-lifecycle/", target="_top"];
    "completion-evidence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Completion and audit<BR/>evidence</B></FONT><BR/><FONT POINT-SIZE="9">Records sanitized lifecycle and<BR/>completion evidence for commands,<BR/>devices, apps, security, recovery,...</FONT><BR/><FONT POINT-SIZE="8"><I>Worker and FastAPI</I></FONT><BR/><FONT POINT-SIZE="7.5">Event</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled", fillcolor="#831843", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Completion and audit evidence. Records sanitized lifecycle and completion evidence for commands, devices, apps, security, recovery, and releases.", URL="../../../../generated/production/architecture/components/completion-evidence/", target="_top"];
    "worker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Worker process</B></FONT><BR/><FONT POINT-SIZE="9">Consumes durable commands and owns<BR/>backend execution for apps,<BR/>security, recovery, releases, and...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Worker process. Consumes durable commands and owns backend execution for apps, security, recovery, releases, and lifecycle work.", URL="../../../../generated/production/architecture/components/worker/", target="_top"];
  }
  "command-lifecycle" -> "completion-evidence" [label="records sanitized lifecycle", tooltip="records sanitized lifecycle (SQLite/NATS)", style="dotted", arrowhead="normal", color="#c4b5fd", fontcolor="#c4b5fd", penwidth="1.15", arrowsize="0.72"];
  "worker" -> "command-lifecycle" [label="claims and updates", tooltip="claims and updates (SQLite/NATS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "state_dependency_0" [label="command_lifecycle", shape="note", style="filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", tooltip="Durable-state dependency"];
  "command-lifecycle" -> "state_dependency_0" [label="state", style="dotted", color="#60a5fa", fontcolor="#60a5fa"];
}
