digraph component_completion_evidence {
  graph [
    rankdir="TB",
    splines="spline",
    compound="true",
    newrank="true",
    nodesep="0.30",
    ranksep="0.52",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#ffffff",
    fontcolor="#172033",
    fontname="Arial",
    label="Completion and audit evidence connections",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#64748b",
    fontcolor="#172033",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#64748b",
    fontcolor="#475569",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_control-api" {
    label="Control API boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "api-read-surfaces" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Prepared read, health,<BR/>readiness,...</B></FONT><BR/><FONT POINT-SIZE="9">Serves side-effect-free prepared<BR/>projections, health/readiness,<BR/>compact diagnostics, and sanitized...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI process</I></FONT><BR/><FONT POINT-SIZE="7.5">Service</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e0e7ff", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Prepared read, health, readiness, diagnostics, and evidence APIs. Serves side-effect-free prepared projections, health/readiness, compact diagnostics, and sanitized evidence lookups.", URL="../../../../generated/production/architecture/components/api-read-surfaces/", target="_top"];
  }
  subgraph "cluster_durable-state" {
    label="Durable-state boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "prepared-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Audit index,<BR/>projection refresh,...</B></FONT><BR/><FONT POINT-SIZE="9">Indexes audit evidence and tracks<BR/>dirty signals, generations,<BR/>committed projections,...</FONT><BR/><FONT POINT-SIZE="8"><I>SQLite</I></FONT><BR/><FONT POINT-SIZE="7.5">Database</FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Audit index, projection refresh, prepared projections, and domain revisions. Indexes audit evidence and tracks dirty signals, generations, committed projections, current-state summaries, and semantic revisions.", URL="../../../../generated/production/architecture/components/prepared-state/", target="_top"];
  }
  subgraph "cluster_managed-device" {
    label="Managed-device boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "agent-command-executor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Device command<BR/>executor</B></FONT><BR/><FONT POINT-SIZE="9">Executes approved device commands<BR/>in the node agent and publishes<BR/>truthful results.</FONT><BR/><FONT POINT-SIZE="8"><I>Node agent</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Device command executor. Executes approved device commands in the node agent and publishes truthful results.", URL="../../../../generated/production/architecture/components/agent-command-executor/", target="_top"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "app-lifecycle-worker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>App lifecycle worker</B></FONT><BR/><FONT POINT-SIZE="9">Owns install, repair, media<BR/>import, backup, restore preview,<BR/>update readiness/apply, and...</FONT><BR/><FONT POINT-SIZE="8"><I>pocket-worker</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="App lifecycle worker. Owns install, repair, media import, backup, restore preview, update readiness/apply, and removal paths only where implemented and safe.", URL="../../../../generated/production/architecture/components/app-lifecycle-worker/", target="_top"];
    "backup-engine" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Backup and<BR/>verification engine</B></FONT><BR/><FONT POINT-SIZE="9">Creates and verifies local<BR/>encrypted backups through<BR/>backend/worker-owned operations.</FONT><BR/><FONT POINT-SIZE="8"><I>Recovery worker</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Backup and verification engine. Creates and verifies local encrypted backups through backend/worker-owned operations.", URL="../../../../generated/production/architecture/components/backup-engine/", target="_top"];
    "completion-evidence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Completion and audit<BR/>evidence</B></FONT><BR/><FONT POINT-SIZE="9">Records sanitized lifecycle and<BR/>completion evidence for commands,<BR/>devices, apps, security, recovery,...</FONT><BR/><FONT POINT-SIZE="8"><I>Worker and FastAPI</I></FONT><BR/><FONT POINT-SIZE="7.5">Event</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled,bold", fillcolor="#fce7f3", color="#172033", fontcolor="#172033", penwidth="2.3", tooltip="Completion and audit evidence. Records sanitized lifecycle and completion evidence for commands, devices, apps, security, recovery, and releases.", URL="../../../../generated/production/architecture/components/completion-evidence/", target="_top"];
  }
  "app-lifecycle-worker" -> "completion-evidence" [label="records sanitized lifecycle", tooltip="records sanitized lifecycle (SQLite/NATS)", style="dotted", arrowhead="normal", color="#7c3aed", fontcolor="#7c3aed", penwidth="1.15", arrowsize="0.72"];
  "backup-engine" -> "completion-evidence" [label="records sanitized lifecycle", tooltip="records sanitized lifecycle (SQLite/NATS)", style="dotted", arrowhead="normal", color="#7c3aed", fontcolor="#7c3aed", penwidth="1.15", arrowsize="0.72"];
  "agent-command-executor" -> "completion-evidence" [label="records sanitized lifecycle", tooltip="records sanitized lifecycle (SQLite/NATS)", style="dotted", arrowhead="normal", color="#7c3aed", fontcolor="#7c3aed", penwidth="1.15", arrowsize="0.72"];
  "completion-evidence" -> "prepared-state" [label="indexes evidence", tooltip="indexes evidence (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb", penwidth="1.15", arrowsize="0.72"];
  "completion-evidence" -> "api-read-surfaces" [label="sanitized lookup", tooltip="sanitized lookup (HTTP)", style="dotted", arrowhead="normal", color="#7c3aed", fontcolor="#7c3aed", penwidth="1.15", arrowsize="0.72"];
  "state_dependency_0" [label="audit_evidence_index", shape="note", style="filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", tooltip="Durable-state dependency"];
  "completion-evidence" -> "state_dependency_0" [label="state", style="dotted", color="#2563eb", fontcolor="#2563eb"];
  "additional_dependencies" [label="Additional dependencies (4)", shape="note", style="dashed,filled", fillcolor="#f8fafc", color="#64748b", fontcolor="#172033", tooltip="Additional dependencies (4)"];
  "completion-evidence" -> "additional_dependencies" [style="dotted", arrowhead="none", color="#475569"];
}
