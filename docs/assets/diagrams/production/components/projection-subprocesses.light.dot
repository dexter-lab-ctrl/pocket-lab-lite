digraph component_projection_subprocesses {
  graph [
    rankdir="TB",
    splines="spline",
    compound="true",
    newrank="true",
    nodesep="0.30",
    ranksep="0.52",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#ffffff",
    fontcolor="#172033",
    fontname="Arial",
    label="Projection subprocesses connections",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#64748b",
    fontcolor="#172033",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#64748b",
    fontcolor="#475569",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_durable-state" {
    label="Durable-state boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "prepared-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Audit index,<BR/>projection refresh,...</B></FONT><BR/><FONT POINT-SIZE="9">Indexes audit evidence and tracks<BR/>dirty signals, generations,<BR/>committed projections,...</FONT><BR/><FONT POINT-SIZE="8"><I>SQLite</I></FONT><BR/><FONT POINT-SIZE="7.5">Database</FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Audit index, projection refresh, prepared projections, and domain revisions. Indexes audit evidence and tracks dirty signals, generations, committed projections, current-state summaries, and semantic revisions.", URL="../../../../generated/production/architecture/components/prepared-state/", target="_top"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "bounded-reconciliation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Bounded queues and<BR/>reconciliation</B></FONT><BR/><FONT POINT-SIZE="9">Bounds admission, coalesces<BR/>low-value work, reconciles queue<BR/>depth, and prevents unrelated...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI and worker<BR/>processes</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Bounded queues and reconciliation. Bounds admission, coalesces low-value work, reconciles queue depth, and prevents unrelated lifecycle deletion.", URL="../../../../generated/production/architecture/components/bounded-reconciliation/", target="_top"];
    "projection-subprocesses" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Projection<BR/>subprocesses</B></FONT><BR/><FONT POINT-SIZE="9">Own CPU-heavy projection<BR/>reconstruction and serialization<BR/>outside the API process.</FONT><BR/><FONT POINT-SIZE="8"><I>Dedicated subprocesses /<BR/>scheduler</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled,bold", fillcolor="#dcfce7", color="#172033", fontcolor="#172033", penwidth="2.3", tooltip="Projection subprocesses. Own CPU-heavy projection reconstruction and serialization outside the API process.", URL="../../../../generated/production/architecture/components/projection-subprocesses/", target="_top"];
    "workflow-execution" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="52" HEIGHT="48" BGCOLOR="#FFFFFF"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Workflow execution</B></FONT><BR/><FONT POINT-SIZE="9">Coordinates multi-step workflow<BR/>state through bounded event<BR/>admission and process-isolated...</FONT><BR/><FONT POINT-SIZE="8"><I>Worker / projection<BR/>subprocess</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Workflow execution. Coordinates multi-step workflow state through bounded event admission and process-isolated projection work.", URL="../../../../generated/production/architecture/components/workflow-execution/", target="_top"];
  }
  "projection-subprocesses" -> "prepared-state" [label="commits generation", tooltip="commits generation (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb", penwidth="1.15", arrowsize="0.72"];
  "bounded-reconciliation" -> "projection-subprocesses" [label="bounds and schedules", tooltip="bounds and schedules (IPC)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569", penwidth="1.15", arrowsize="0.72"];
  "workflow-execution" -> "projection-subprocesses" [label="emits compact projection events", tooltip="emits compact projection events (IPC)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb", penwidth="1.15", arrowsize="0.72"];
  "state_dependency_0" [label="projection_refresh_state", shape="note", style="filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", tooltip="Durable-state dependency"];
  "projection-subprocesses" -> "state_dependency_0" [label="state", style="dotted", color="#2563eb", fontcolor="#2563eb"];
  "state_dependency_1" [label="projection_dirty_signals", shape="note", style="filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", tooltip="Durable-state dependency"];
  "projection-subprocesses" -> "state_dependency_1" [label="state", style="dotted", color="#2563eb", fontcolor="#2563eb"];
}
