    "projection-subprocesses" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__projection-subprocesses" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Projection subprocesses</B></FONT><BR/><FONT POINT-SIZE="9">Own CPU-heavy projection<BR/>reconstruction and serialization...</FONT><BR/><FONT POINT-SIZE="8"><I>Dedicated subprocesses /<BR/>scheduler · pocket-api and...</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Projection subprocesses. Own CPU-heavy projection reconstruction and serialization outside the API process.", URL="../../../../generated/production/architecture/components/projection-subprocesses/", target="_top", margin="0.10,0.08"];
