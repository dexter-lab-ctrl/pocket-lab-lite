digraph component_pwa {
  graph [
    rankdir="TB",
    splines="spline",
    compound="true",
    newrank="true",
    nodesep="0.30",
    ranksep="0.52",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#0f172a",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="React / Vite PWA connections",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#94a3b8",
    fontcolor="#f8fafc",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#94a3b8",
    fontcolor="#cbd5e1",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_browser" {
    label="Browser trust boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "browser" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__browser" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Browser</B></FONT><BR/><FONT POINT-SIZE="9">Hosts the installed or web PWA and<BR/>enforces browser-origin...</FONT><BR/><FONT POINT-SIZE="8"><I>User device · Browser</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#0c4a6e", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Browser. Hosts the installed or web PWA and enforces browser-origin boundaries.", URL="../../../../generated/production/architecture/components/browser/", target="_top", margin="0.10,0.08"];
    "frontend-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__frontend-state" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Frontend state ownership</B></FONT><BR/><FONT POINT-SIZE="9">Combines service worker, TanStack<BR/>Query, Dexie safe snapshots,...</FONT><BR/><FONT POINT-SIZE="8"><I>Browser / installed PWA</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#0c4a6e", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Frontend state ownership. Combines service worker, TanStack Query, Dexie safe snapshots, Zustand UI-only state, XState guided flows, API client, error boundaries, and generated fixtures without owning backend truth.", URL="../../../../generated/production/architecture/components/frontend-state/", target="_top", margin="0.10,0.08"];
    "pwa" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__pwa" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="7"><B>CURRENT COMPONENT</B></FONT><BR/><FONT POINT-SIZE="13"><B>React / Vite PWA</B></FONT><BR/><FONT POINT-SIZE="9">Renders Lite screens and sends<BR/>same-origin requests only to...</FONT><BR/><FONT POINT-SIZE="8"><I>Browser / installed PWA</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled,bold", fillcolor="#0c4a6e", color="#f8fafc", fontcolor="#f8fafc", penwidth="2.5", tooltip="React / Vite PWA. Renders Lite screens and sends same-origin requests only to FastAPI through Caddy.", URL="../../../../generated/production/architecture/components/pwa/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_control-api" {
    label="Control API boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "app-catalog" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__app-catalog" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>App Catalog</B></FONT><BR/><FONT POINT-SIZE="9">Presents backend-owned app<BR/>lifecycle and safe action...</FONT><BR/><FONT POINT-SIZE="8"><I>PWA plus FastAPI prepared<BR/>reads · Lite UI / Lite API</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#312e81", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="App Catalog. Presents backend-owned app lifecycle and safe action readiness, including same-origin Open routes and Manage details.", URL="../../../../generated/production/architecture/components/app-catalog/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_server-host" {
    label="Server-host boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "caddy" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__caddy" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Caddy same-origin proxy</B></FONT><BR/><FONT POINT-SIZE="9">Serves the PWA and routes<BR/>/api/lite/* and managed app paths...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host · PM2</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#4c1d95", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Caddy same-origin proxy. Serves the PWA and routes /api/lite/* and managed app paths without exposing backend secrets.", URL="../../../../generated/production/architecture/components/caddy/", target="_top", margin="0.10,0.08"];
  }
  "browser" -> "pwa" [label="loads and hosts", tooltip="loads and hosts (Browser runtime)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "app-catalog" -> "pwa" [label="app cards and actions", tooltip="app cards and actions (HTTPS)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
  "pwa" -> "caddy" [label="same-origin request", tooltip="same-origin request (HTTPS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "pwa" -> "frontend-state" [label="selects and renders", tooltip="selects and renders (React)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
}
