digraph remote_access {
  graph [
    rankdir="LR",
    splines="polyline",
    compound="true",
    newrank="true",
    nodesep="0.40",
    ranksep="0.72",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#0f172a",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="Tailscale readiness",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#94a3b8",
    fontcolor="#f8fafc",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#94a3b8",
    fontcolor="#cbd5e1",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_browser" {
    label="Browser trust boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "pwa" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>React / Vite PWA</B></FONT><BR/><FONT POINT-SIZE="9">Renders Lite screens and sends<BR/>same-origin requests only to<BR/>FastAPI through Caddy.</FONT><BR/><FONT POINT-SIZE="8"><I>Browser / installed PWA</I></FONT><BR/><FONT POINT-SIZE="7.5">Ui</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#0c4a6e", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="React / Vite PWA. Renders Lite screens and sends same-origin requests only to FastAPI through Caddy.", URL="../../../../generated/production/architecture/components/pwa/", target="_top"];
  }
  subgraph "cluster_control-api" {
    label="Control API boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "api-read-surfaces" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Prepared read, health,<BR/>readiness,...</B></FONT><BR/><FONT POINT-SIZE="9">Serves side-effect-free prepared<BR/>projections, health/readiness,<BR/>compact diagnostics, and sanitized...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI process</I></FONT><BR/><FONT POINT-SIZE="7.5">Service</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#312e81", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Prepared read, health, readiness, diagnostics, and evidence APIs. Serves side-effect-free prepared projections, health/readiness, compact diagnostics, and sanitized evidence lookups.", URL="../../../../generated/production/architecture/components/api-read-surfaces/", target="_top"];
    "remote-readiness" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Remote-access<BR/>readiness checks</B></FONT><BR/><FONT POINT-SIZE="9">Combines tailscaled state, Tailnet<BR/>IPv4, NATS listener reachability,<BR/>agent/supervisor status, and safe...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI read surface</I></FONT><BR/><FONT POINT-SIZE="7.5">Decision</FONT></TD></TR></TABLE>>, shape="diamond", style="rounded,filled", fillcolor="#7f1d1d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Remote-access readiness checks. Combines tailscaled state, Tailnet IPv4, NATS listener reachability, agent/supervisor status, and safe guidance.", URL="../../../../generated/production/architecture/components/remote-readiness/", target="_top"];
  }
  subgraph "cluster_managed-device" {
    label="Managed-device boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "node-agent" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Lite node agent</B></FONT><BR/><FONT POINT-SIZE="9">Connects to NATS, publishes<BR/>heartbeat/telemetry/health,<BR/>handles device commands, and...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host or joined<BR/>device</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Lite node agent. Connects to NATS, publishes heartbeat/telemetry/health, handles device commands, and reconnects after outages.", URL="../../../../generated/production/architecture/components/node-agent/", target="_top"];
    "agent-supervisor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Lite agent supervisor</B></FONT><BR/><FONT POINT-SIZE="9">Runs separately from the agent,<BR/>reads the protected agent<BR/>environment, and starts or...</FONT><BR/><FONT POINT-SIZE="8"><I>Joined device</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Lite agent supervisor. Runs separately from the agent, reads the protected agent environment, and starts or restarts failed agents without overwriting identity.", URL="../../../../generated/production/architecture/components/agent-supervisor/", target="_top"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "nats-jetstream" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>NATS / JetStream</B></FONT><BR/><FONT POINT-SIZE="9">Provides the command and event<BR/>backbone with durable delivery; it<BR/>is never contacted directly by the...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host</I></FONT><BR/><FONT POINT-SIZE="7.5">Event</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled", fillcolor="#831843", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="NATS / JetStream. Provides the command and event backbone with durable delivery; it is never contacted directly by the frontend.", URL="../../../../generated/production/architecture/components/nats-jetstream/", target="_top"];
  }
  subgraph "cluster_server-host" {
    label="Server-host boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "tailscaled" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>tailscaled daemon</B></FONT><BR/><FONT POINT-SIZE="9">Owns Tailscale networking; startup<BR/>scripts may detect/start it safely<BR/>while read APIs remain...</FONT><BR/><FONT POINT-SIZE="8"><I>Android/Termux server host</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="tailscaled daemon. Owns Tailscale networking; startup scripts may detect/start it safely while read APIs remain side-effect-free.", URL="../../../../generated/production/architecture/components/tailscaled/", target="_top"];
    "caddy" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Caddy same-origin<BR/>proxy</B></FONT><BR/><FONT POINT-SIZE="9">Serves the PWA and routes<BR/>/api/lite/* and managed app paths<BR/>without exposing backend secrets.</FONT><BR/><FONT POINT-SIZE="8"><I>Server host</I></FONT><BR/><FONT POINT-SIZE="7.5">Proxy</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#4c1d95", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Caddy same-origin proxy. Serves the PWA and routes /api/lite/* and managed app paths without exposing backend secrets.", URL="../../../../generated/production/architecture/components/caddy/", target="_top"];
    "nats-listeners" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Primary and secondary<BR/>NATS listeners</B></FONT><BR/><FONT POINT-SIZE="9">Exposes local and verified<BR/>Tailnet-reachable NATS listeners<BR/>for agents without hardcoding...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host</I></FONT><BR/><FONT POINT-SIZE="7.5">Network</FONT></TD></TR></TABLE>>, shape="hexagon", style="rounded,filled", fillcolor="#155e75", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Primary and secondary NATS listeners. Exposes local and verified Tailnet-reachable NATS listeners for agents without hardcoding credentials or addresses.", URL="../../../../generated/production/architecture/components/nats-listeners/", target="_top"];
  }
  subgraph "cluster_tailnet" {
    label="Private network and Tailnet boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "tailscale" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Tailscale remote<BR/>access</B></FONT><BR/><FONT POINT-SIZE="9">Provides private Tailnet<BR/>connectivity and HTTPS identity<BR/>without becoming a browser-held...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host and joined<BR/>devices</I></FONT><BR/><FONT POINT-SIZE="7.5">Network</FONT></TD></TR></TABLE>>, shape="hexagon", style="rounded,filled", fillcolor="#155e75", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Tailscale remote access. Provides private Tailnet connectivity and HTTPS identity without becoming a browser-held secret or control owner.", URL="../../../../generated/production/architecture/components/tailscale/", target="_top"];
    "lan" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Local LAN</B></FONT><BR/><FONT POINT-SIZE="9">Provides local-device access to<BR/>the same-origin Caddy endpoint<BR/>without hardcoded addresses.</FONT><BR/><FONT POINT-SIZE="8"><I>Private local network</I></FONT><BR/><FONT POINT-SIZE="7.5">Network</FONT></TD></TR></TABLE>>, shape="hexagon", style="rounded,filled", fillcolor="#155e75", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.35", tooltip="Local LAN. Provides local-device access to the same-origin Caddy endpoint without hardcoded addresses.", URL="../../../../generated/production/architecture/components/lan/", target="_top"];
  }
  "lan" -> "caddy" [label="local HTTPS", tooltip="local HTTPS (HTTPS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "nats-listeners" -> "nats-jetstream" [label="listener endpoints", tooltip="listener endpoints (NATS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "pwa" -> "caddy" [label="same-origin request", tooltip="same-origin request (HTTPS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "remote-readiness" -> "api-read-surfaces" [label="readiness summary", tooltip="readiness summary (HTTP)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa"];
  "tailscaled" -> "remote-readiness" [label="daemon status", tooltip="daemon status (Local status)", style="dashed", arrowhead="normal", color="#6ee7b7", fontcolor="#6ee7b7"];
  "nats-listeners" -> "remote-readiness" [label="listener reachability", tooltip="listener reachability (TCP)", style="dashed", arrowhead="normal", color="#6ee7b7", fontcolor="#6ee7b7"];
  "tailscale" -> "caddy" [label="Tailnet HTTPS", tooltip="Tailnet HTTPS (HTTPS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "tailscale" -> "nats-listeners" [label="Tailnet reachability", tooltip="Tailnet reachability (TCP)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "tailscaled" -> "tailscale" [label="provides interface", tooltip="provides interface (Tailscale)", style="dashed", arrowhead="normal", color="#6ee7b7", fontcolor="#6ee7b7"];
}
