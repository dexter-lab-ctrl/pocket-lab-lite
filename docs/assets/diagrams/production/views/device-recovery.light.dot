    "agent-signals" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__agent-signals" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Heartbeat, telemetry, and<BR/>health publishers</B></FONT><BR/><FONT POINT-SIZE="9">Publish fresh runtime signals used<BR/>to derive Online, Offline, Stale,...</FONT><BR/><FONT POINT-SIZE="8"><I>Node agent · node agent</I></FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#fce7f3", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Heartbeat, telemetry, and health publishers. Publish fresh runtime signals used to derive Online, Offline, Stale, Agent stopped, and Remote access not ready states.", URL="../../../../generated/production/architecture/components/agent-signals/", target="_top", margin="0.10,0.08"];
    "agent-command-executor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__agent-command-executor" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Device command executor</B></FONT><BR/><FONT POINT-SIZE="9">Executes approved device commands<BR/>in the node agent and publishes...</FONT><BR/><FONT POINT-SIZE="8"><I>Node agent · node agent</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Device command executor. Executes approved device commands in the node agent and publishes truthful results.", URL="../../../../generated/production/architecture/components/agent-command-executor/", target="_top", margin="0.10,0.08"];
    "agent-supervisor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__agent-supervisor" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Lite agent supervisor</B></FONT><BR/><FONT POINT-SIZE="9">Runs separately from the agent,<BR/>reads the protected agent...</FONT><BR/><FONT POINT-SIZE="8"><I>Joined device · PM2</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Lite agent supervisor. Runs separately from the agent, reads the protected agent environment, and starts or restarts failed agents without overwriting identity.", URL="../../../../generated/production/architecture/components/agent-supervisor/", target="_top", margin="0.10,0.08"];
    "agent-recovery" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__agent-recovery" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Reconnect watchdog and<BR/>supervisor recovery</B></FONT><BR/><FONT POINT-SIZE="9">Separates running-but-disconnected<BR/>recovery from stopped-agent...</FONT><BR/><FONT POINT-SIZE="8"><I>Joined device · agent and supervisor</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Reconnect watchdog and supervisor recovery. Separates running-but-disconnected recovery from stopped-agent recovery and exposes truthful guidance when no supervisor is available.", URL="../../../../generated/production/architecture/components/agent-recovery/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
