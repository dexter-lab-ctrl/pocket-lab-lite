  "api-domain-surfaces" -> "nats-jetstream" [label="publishes validated command", tooltip="publishes validated command (NATS)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569", penwidth="1.15", arrowsize="0.72"];
  "agent-command-executor" -> "completion-evidence" [label="records sanitized lifecycle", tooltip="records sanitized lifecycle (SQLite/NATS)", style="dotted", arrowhead="normal", color="#7c3aed", fontcolor="#7c3aed", penwidth="1.15", arrowsize="0.72"];
  "agent-command-executor" -> "node-agent" [label="executes within", tooltip="executes within (Python)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569", penwidth="1.15", arrowsize="0.72"];
  "nats-jetstream" -> "device-state" [label="fleet events projected", tooltip="fleet events projected (NATS/SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb", penwidth="1.15", arrowsize="0.72"];
  "agent-recovery" -> "node-agent" [label="reconnect/restart", tooltip="reconnect/restart (NATS/process)", style="dashed", arrowhead="vee", color="#b45309", fontcolor="#b45309", penwidth="1.15", arrowsize="0.72"];
  "agent-signals" -> "nats-jetstream" [label="heartbeat/telemetry/health", tooltip="heartbeat/telemetry/health (NATS)", style="dashed", arrowhead="normal", color="#047857", fontcolor="#047857", penwidth="1.15", arrowsize="0.72"];
  "agent-signals" -> "device-state" [label="updates device truth", tooltip="updates device truth (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb", penwidth="1.15", arrowsize="0.72"];
  "agent-supervisor" -> "agent-recovery" [label="stopped-agent recovery", tooltip="stopped-agent recovery (Local process)", style="dashed", arrowhead="vee", color="#b45309", fontcolor="#b45309", penwidth="1.15", arrowsize="0.72"];
