  "app-lifecycle-worker" -> "app-recovery-update" [label="runs backup/update paths", tooltip="runs backup/update paths (Python)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "app-lifecycle-worker" -> "media-app-health" [label="refreshes canonical readiness", tooltip="refreshes canonical readiness (Python)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "caddy" -> "photoprism" [label="same-origin /apps path", tooltip="same-origin /apps path (HTTP)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "app-catalog" -> "pwa" [label="app cards and actions", tooltip="app cards and actions (HTTPS)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
  "app-workflow-state" -> "app-catalog" [label="catalog/action projection", tooltip="catalog/action projection (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
  "app-lifecycle-worker" -> "completion-evidence" [label="records sanitized lifecycle", tooltip="records sanitized lifecycle (SQLite/NATS)", style="dotted", arrowhead="normal", color="#c4b5fd", fontcolor="#c4b5fd", penwidth="1.15", arrowsize="0.72"];
  "proot-ubuntu" -> "photoprism" [label="hosts process", tooltip="hosts process (Local process)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "pwa" -> "caddy" [label="same-origin request", tooltip="same-origin request (HTTPS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "app-lifecycle-worker" -> "app-workflow-state" [label="updates app state", tooltip="updates app state (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
