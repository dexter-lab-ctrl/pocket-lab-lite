  "restore-preview" -> "checkpoints-retention" [label="creates checkpoint before apply", tooltip="creates checkpoint before apply (NATS)", style="dashed", arrowhead="vee", color="#b45309", fontcolor="#b45309"];
  "checkpoints-retention" -> "retirement-database-recovery" [label="provides recovery point", tooltip="provides recovery point (SQLite)", style="dashed", arrowhead="vee", color="#b45309", fontcolor="#b45309"];
  "recovery-state" -> "sqlite" [label="stored in", tooltip="stored in (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
