digraph release_rollback {
  graph [
    rankdir="LR",
    splines="ortho",
    compound="true",
    newrank="true",
    nodesep="0.34",
    ranksep="0.64",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#ffffff",
    fontcolor="#172033",
    fontname="Arial",
    label="Release subprocess and atomic rollback",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#64748b",
    fontcolor="#172033",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#64748b",
    fontcolor="#475569",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_durable-state" {
    label="Durable-state boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "release-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Installed release and<BR/>runtime state</B></FONT><BR/><FONT POINT-SIZE="9">Stores installed-release identity<BR/>and release-runtime projection for<BR/>truthful comparison, staging,...</FONT><BR/><FONT POINT-SIZE="8">SQLite</FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", penwidth="1.15", tooltip="Installed release and runtime state. Stores installed-release identity and release-runtime projection for truthful comparison, staging, apply, rollback, and last-known-good state.", URL="../../../../generated/production/architecture/components/release-state/", target="_top"];
  }
  subgraph "cluster_external-release" {
    label="External release boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "github-repository" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>GitHub repository</B></FONT><BR/><FONT POINT-SIZE="9">Hosts source and release workflow<BR/>definitions; it is not a Lite<BR/>runtime apply owner.</FONT><BR/><FONT POINT-SIZE="8">External source hosting</FONT></TD></TR></TABLE>>, shape="ellipse", style="rounded,filled", fillcolor="#f3e8ff", color="#64748b", fontcolor="#172033", penwidth="1.15", tooltip="GitHub repository. Hosts source and release workflow definitions; it is not a Lite runtime apply owner.", URL="../../../../generated/production/architecture/components/github-repository/", target="_top"];
    "github-release" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>GitHub Release</B></FONT><BR/><FONT POINT-SIZE="9">Publishes the verified Lite<BR/>release manifest, checksums, and<BR/>dist.zip assets for the release...</FONT><BR/><FONT POINT-SIZE="8">GitHub</FONT></TD></TR></TABLE>>, shape="ellipse", style="rounded,filled", fillcolor="#f3e8ff", color="#64748b", fontcolor="#172033", penwidth="1.15", tooltip="GitHub Release. Publishes the verified Lite release manifest, checksums, and dist.zip assets for the release subprocess.", URL="../../../../generated/production/architecture/components/github-release/", target="_top"];
    "release-artifacts" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Date-based Lite tag,<BR/>dist.zip, checksums,...</B></FONT><BR/><FONT POINT-SIZE="9">Defines immutable release identity<BR/>and the exact assets required for<BR/>a Lite installation.</FONT><BR/><FONT POINT-SIZE="8">GitHub Release / staging</FONT></TD></TR></TABLE>>, shape="note", style="rounded,filled", fillcolor="#ffedd5", color="#64748b", fontcolor="#172033", penwidth="1.15", tooltip="Date-based Lite tag, dist.zip, checksums, and release manifest. Defines immutable release identity and the exact assets required for a Lite installation.", URL="../../../../generated/production/architecture/components/release-artifacts/", target="_top"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "release-staging" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Download staging and<BR/>release verification</B></FONT><BR/><FONT POINT-SIZE="9">Downloads on explicit/manual or<BR/>stable cadence, verifies<BR/>repository/tag/manifest/assets/checksums,...</FONT><BR/><FONT POINT-SIZE="8">Release subprocess</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.15", tooltip="Download staging and release verification. Downloads on explicit/manual or stable cadence, verifies repository/tag/manifest/assets/checksums, and stages without touching the active PWA.", URL="../../../../generated/production/architecture/components/release-staging/", target="_top"];
    "release-subprocess" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Release subprocess</B></FONT><BR/><FONT POINT-SIZE="9">Owns network, download,<BR/>verification, staging, apply, and<BR/>rollback work outside the FastAPI...</FONT><BR/><FONT POINT-SIZE="8">Dedicated subprocess</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.15", tooltip="Release subprocess. Owns network, download, verification, staging, apply, and rollback work outside the FastAPI event loop.", URL="../../../../generated/production/architecture/components/release-subprocess/", target="_top"];
    "completion-evidence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Completion and audit<BR/>evidence</B></FONT><BR/><FONT POINT-SIZE="9">Records sanitized lifecycle and<BR/>completion evidence for commands,<BR/>devices, apps, security, recovery,...</FONT><BR/><FONT POINT-SIZE="8">Worker and FastAPI</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled", fillcolor="#fce7f3", color="#64748b", fontcolor="#172033", penwidth="1.15", tooltip="Completion and audit evidence. Records sanitized lifecycle and completion evidence for commands, devices, apps, security, recovery, and releases.", URL="../../../../generated/production/architecture/components/completion-evidence/", target="_top"];
  }
  subgraph "cluster_server-host" {
    label="Server-host boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "atomic-promotion" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Atomic PWA promotion</B></FONT><BR/><FONT POINT-SIZE="9">Promotes a verified staged PWA<BR/>atomically and keeps the previous<BR/>release available for rollback.</FONT><BR/><FONT POINT-SIZE="8">Server host</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.15", tooltip="Atomic PWA promotion. Promotes a verified staged PWA atomically and keeps the previous release available for rollback.", URL="../../../../generated/production/architecture/components/atomic-promotion/", target="_top"];
    "post-switch-health" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Post-switch health<BR/>validation</B></FONT><BR/><FONT POINT-SIZE="9">Validates Caddy/FastAPI/PWA health<BR/>after promotion before declaring<BR/>the release current.</FONT><BR/><FONT POINT-SIZE="8">Release subprocess against<BR/>local services</FONT></TD></TR></TABLE>>, shape="diamond", style="rounded,filled", fillcolor="#fef2f2", color="#64748b", fontcolor="#172033", penwidth="1.15", tooltip="Post-switch health validation. Validates Caddy/FastAPI/PWA health after promotion before declaring the release current.", URL="../../../../generated/production/architecture/components/post-switch-health/", target="_top"];
    "last-known-good" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Last-known-good state<BR/>and rollback</B></FONT><BR/><FONT POINT-SIZE="9">Records the verified prior release<BR/>and restores it atomically when<BR/>post-switch validation fails.</FONT><BR/><FONT POINT-SIZE="8">Server host / release<BR/>subprocess</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.15", tooltip="Last-known-good state and rollback. Records the verified prior release and restores it atomically when post-switch validation fails.", URL="../../../../generated/production/architecture/components/last-known-good/", target="_top"];
    "caddy" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Caddy same-origin<BR/>proxy</B></FONT><BR/><FONT POINT-SIZE="9">Serves the PWA and routes<BR/>/api/lite/* and managed app paths<BR/>without exposing backend secrets.</FONT><BR/><FONT POINT-SIZE="8">Server host</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#ede9fe", color="#64748b", fontcolor="#172033", penwidth="1.15", tooltip="Caddy same-origin proxy. Serves the PWA and routes /api/lite/* and managed app paths without exposing backend secrets.", URL="../../../../generated/production/architecture/components/caddy/", target="_top"];
  }
  "release-artifacts" -> "release-staging" [label="download and verify", tooltip="download and verify (HTTPS)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
  "release-subprocess" -> "completion-evidence" [label="records sanitized lifecycle", tooltip="records sanitized lifecycle (SQLite/NATS)", style="dotted", arrowhead="normal", color="#7c3aed", fontcolor="#7c3aed"];
  "post-switch-health" -> "release-state" [label="mark current/failed", tooltip="mark current/failed (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "post-switch-health" -> "last-known-good" [label="failure trigger", tooltip="failure trigger (IPC)", style="dashed", arrowhead="vee", color="#b45309", fontcolor="#b45309"];
  "atomic-promotion" -> "caddy" [label="serves active PWA", tooltip="serves active PWA (Filesystem/HTTP)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
  "atomic-promotion" -> "post-switch-health" [label="validate switched release", tooltip="validate switched release (HTTP)", style="dashed", arrowhead="normal", color="#047857", fontcolor="#047857"];
  "github-release" -> "release-artifacts" [label="publishes assets", tooltip="publishes assets (HTTPS)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "github-repository" -> "github-release" [label="annotated tag workflow", tooltip="annotated tag workflow (GitHub Actions)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
  "last-known-good" -> "atomic-promotion" [label="restore prior PWA", tooltip="restore prior PWA (Filesystem)", style="dashed", arrowhead="vee", color="#b45309", fontcolor="#b45309"];
  "release-staging" -> "release-subprocess" [label="verified stage", tooltip="verified stage (IPC/filesystem)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "release-subprocess" -> "release-state" [label="updates release state", tooltip="updates release state (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "release-subprocess" -> "atomic-promotion" [label="apply", tooltip="apply (Filesystem)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
}
