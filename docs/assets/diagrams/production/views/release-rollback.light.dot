    "github-release" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__github-release" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>GitHub Release</B></FONT><BR/><FONT POINT-SIZE="9">Publishes the verified Lite<BR/>release manifest, checksums, and...</FONT><BR/><FONT POINT-SIZE="8"><I>GitHub · GitHub Actions</I></FONT></TD></TR></TABLE>>, shape="ellipse", style="rounded,filled", fillcolor="#f3e8ff", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="GitHub Release. Publishes the verified Lite release manifest, checksums, and dist.zip assets for the release subprocess.", URL="../../../../generated/production/architecture/components/github-release/", target="_top", margin="0.16,0.11"];
    "release-artifacts" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__release-artifacts" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Date-based Lite tag,<BR/>dist.zip, checksums, and...</B></FONT><BR/><FONT POINT-SIZE="9">Defines immutable release identity<BR/>and the exact assets required for...</FONT><BR/><FONT POINT-SIZE="8"><I>GitHub Release / staging · Release workflow</I></FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#ffedd5", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Date-based Lite tag, dist.zip, checksums, and release manifest. Defines immutable release identity and the exact assets required for a Lite installation.", URL="../../../../generated/production/architecture/components/release-artifacts/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "release-staging" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__release-staging" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Download staging and<BR/>release verification</B></FONT><BR/><FONT POINT-SIZE="9">Downloads on explicit/manual or<BR/>stable cadence, verifies...</FONT><BR/><FONT POINT-SIZE="8"><I>Release subprocess · pocket-worker</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Download staging and release verification. Downloads on explicit/manual or stable cadence, verifies repository/tag/manifest/assets/checksums, and stages without touching the active PWA.", URL="../../../../generated/production/architecture/components/release-staging/", target="_top", margin="0.10,0.08"];
    "release-subprocess" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__release-subprocess" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Release subprocess</B></FONT><BR/><FONT POINT-SIZE="9">Owns network, download,<BR/>verification, staging, apply, and...</FONT><BR/><FONT POINT-SIZE="8"><I>Dedicated subprocess · pocket-worker</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Release subprocess. Owns network, download, verification, staging, apply, and rollback work outside the FastAPI event loop.", URL="../../../../generated/production/architecture/components/release-subprocess/", target="_top", margin="0.10,0.08"];
    "completion-evidence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__completion-evidence" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Completion and audit<BR/>evidence</B></FONT><BR/><FONT POINT-SIZE="9">Records sanitized lifecycle and<BR/>completion evidence for commands,...</FONT><BR/><FONT POINT-SIZE="8"><I>Worker and FastAPI · worker / FastAPI</I></FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#fce7f3", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Completion and audit evidence. Records sanitized lifecycle and completion evidence for commands, devices, apps, security, recovery, and releases.", URL="../../../../generated/production/architecture/components/completion-evidence/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_server-host" {
    label="Server-host boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "atomic-promotion" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__atomic-promotion" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Atomic PWA promotion</B></FONT><BR/><FONT POINT-SIZE="9">Promotes a verified staged PWA<BR/>atomically and keeps the previous...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host · release subprocess</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Atomic PWA promotion. Promotes a verified staged PWA atomically and keeps the previous release available for rollback.", URL="../../../../generated/production/architecture/components/atomic-promotion/", target="_top", margin="0.10,0.08"];
    "post-switch-health" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__post-switch-health" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Post-switch health<BR/>validation</B></FONT><BR/><FONT POINT-SIZE="9">Validates Caddy/FastAPI/PWA health<BR/>after promotion before declaring...</FONT><BR/><FONT POINT-SIZE="8"><I>Release subprocess against<BR/>local services · release subprocess</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#fef2f2", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Post-switch health validation. Validates Caddy/FastAPI/PWA health after promotion before declaring the release current.", URL="../../../../generated/production/architecture/components/post-switch-health/", target="_top", margin="0.10,0.08"];
    "last-known-good" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__last-known-good" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Last-known-good state and<BR/>rollback</B></FONT><BR/><FONT POINT-SIZE="9">Records the verified prior release<BR/>and restores it atomically when...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host / release<BR/>subprocess · release subprocess</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Last-known-good state and rollback. Records the verified prior release and restores it atomically when post-switch validation fails.", URL="../../../../generated/production/architecture/components/last-known-good/", target="_top", margin="0.10,0.08"];
    "caddy" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__caddy" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Caddy same-origin proxy</B></FONT><BR/><FONT POINT-SIZE="9">Serves the PWA and routes<BR/>/api/lite/* and managed app paths...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host · PM2</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#ede9fe", color="#64748b", fontcolor="#172033", penwidth="1.25", tooltip="Caddy same-origin proxy. Serves the PWA and routes /api/lite/* and managed app paths without exposing backend secrets.", URL="../../../../generated/production/architecture/components/caddy/", target="_top", margin="0.10,0.08"];
  }
  "release-artifacts" -> "release-staging" [label="download and verify", tooltip="download and verify (HTTPS)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569", penwidth="1.15", arrowsize="0.72"];
  "release-subprocess" -> "completion-evidence" [label="records sanitized lifecycle", tooltip="records sanitized lifecycle (SQLite/NATS)", style="dotted", arrowhead="normal", color="#7c3aed", fontcolor="#7c3aed", penwidth="1.15", arrowsize="0.72"];
  "post-switch-health" -> "release-state" [label="mark current/failed", tooltip="mark current/failed (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb", penwidth="1.15", arrowsize="0.72"];
  "post-switch-health" -> "last-known-good" [label="failure trigger", tooltip="failure trigger (IPC)", style="dashed", arrowhead="vee", color="#b45309", fontcolor="#b45309", penwidth="1.15", arrowsize="0.72"];
  "atomic-promotion" -> "caddy" [label="serves active PWA", tooltip="serves active PWA (Filesystem/HTTP)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569", penwidth="1.15", arrowsize="0.72"];
  "atomic-promotion" -> "post-switch-health" [label="validate switched release", tooltip="validate switched release (HTTP)", style="dashed", arrowhead="normal", color="#047857", fontcolor="#047857", penwidth="1.15", arrowsize="0.72"];
  "github-release" -> "release-artifacts" [label="publishes assets", tooltip="publishes assets (HTTPS)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb", penwidth="1.15", arrowsize="0.72"];
  "github-repository" -> "github-release" [label="annotated tag workflow", tooltip="annotated tag workflow (GitHub Actions)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569", penwidth="1.15", arrowsize="0.72"];
  "last-known-good" -> "atomic-promotion" [label="restore prior PWA", tooltip="restore prior PWA (Filesystem)", style="dashed", arrowhead="vee", color="#b45309", fontcolor="#b45309", penwidth="1.15", arrowsize="0.72"];
  "release-staging" -> "release-subprocess" [label="verified stage", tooltip="verified stage (IPC/filesystem)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb", penwidth="1.15", arrowsize="0.72"];
  "release-subprocess" -> "release-state" [label="updates release state", tooltip="updates release state (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb", penwidth="1.15", arrowsize="0.72"];
  "release-subprocess" -> "atomic-promotion" [label="apply", tooltip="apply (Filesystem)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569", penwidth="1.15", arrowsize="0.72"];
}
