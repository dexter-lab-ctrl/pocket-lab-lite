digraph device_onboarding {
  graph [
    rankdir="LR",
    splines="polyline",
    compound="true",
    newrank="true",
    nodesep="0.40",
    ranksep="0.72",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#ffffff",
    fontcolor="#172033",
    fontname="Arial",
    label="Device onboarding",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#64748b",
    fontcolor="#172033",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#64748b",
    fontcolor="#475569",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_browser" {
    label="Browser trust boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "pwa" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>React / Vite PWA</B></FONT><BR/><FONT POINT-SIZE="9">Renders Lite screens and sends<BR/>same-origin requests only to<BR/>FastAPI through Caddy.</FONT><BR/><FONT POINT-SIZE="8"><I>Browser / installed PWA</I></FONT><BR/><FONT POINT-SIZE="7.5">Ui</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e0f2fe", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="React / Vite PWA. Renders Lite screens and sends same-origin requests only to FastAPI through Caddy.", URL="../../../../generated/production/architecture/components/pwa/", target="_top"];
  }
  subgraph "cluster_control-api" {
    label="Control API boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "lite-api" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>FastAPI /api/lite/*</B></FONT><BR/><FONT POINT-SIZE="9">Validates requests, owns safe read<BR/>APIs, admits commands, and never<BR/>delegates browser execution...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host</I></FONT><BR/><FONT POINT-SIZE="7.5">Service</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e0e7ff", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="FastAPI /api/lite/*. Validates requests, owns safe read APIs, admits commands, and never delegates browser execution directly to NATS or shell.", URL="../../../../generated/production/architecture/components/lite-api/", target="_top"];
    "api-guards" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Identity,<BR/>authentication, and...</B></FONT><BR/><FONT POINT-SIZE="9">Applies identity guards, duplicate<BR/>checks, protected-host checks, and<BR/>fail-closed invite/bootstrap...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI process</I></FONT><BR/><FONT POINT-SIZE="7.5">Service</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e0e7ff", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Identity, authentication, and invite guards. Applies identity guards, duplicate checks, protected-host checks, and fail-closed invite/bootstrap acceptance.", URL="../../../../generated/production/architecture/components/api-guards/", target="_top"];
  }
  subgraph "cluster_durable-state" {
    label="Durable-state boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "invite-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Invite and identity<BR/>lifecycle</B></FONT><BR/><FONT POINT-SIZE="9">Tracks pending, accepted, revoked,<BR/>blocked, and consumed<BR/>invite/identity state with...</FONT><BR/><FONT POINT-SIZE="8"><I>SQLite</I></FONT><BR/><FONT POINT-SIZE="7.5">Database</FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Invite and identity lifecycle. Tracks pending, accepted, revoked, blocked, and consumed invite/identity state with duplicate and mismatch guards.", URL="../../../../generated/production/architecture/components/invite-state/", target="_top"];
    "device-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Enrollment and device<BR/>lifecycle state</B></FONT><BR/><FONT POINT-SIZE="9">Retains enrolled devices across<BR/>connectivity loss and separates<BR/>durable enrollment, current state,...</FONT><BR/><FONT POINT-SIZE="8"><I>SQLite</I></FONT><BR/><FONT POINT-SIZE="7.5">Database</FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Enrollment and device lifecycle state. Retains enrolled devices across connectivity loss and separates durable enrollment, current state, health, supervisor state, and recovery history.", URL="../../../../generated/production/architecture/components/device-state/", target="_top"];
  }
  subgraph "cluster_managed-device" {
    label="Managed-device boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "node-agent" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Lite node agent</B></FONT><BR/><FONT POINT-SIZE="9">Connects to NATS, publishes<BR/>heartbeat/telemetry/health,<BR/>handles device commands, and...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host or joined<BR/>device</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Lite node agent. Connects to NATS, publishes heartbeat/telemetry/health, handles device commands, and reconnects after outages.", URL="../../../../generated/production/architecture/components/node-agent/", target="_top"];
    "agent-supervisor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Lite agent supervisor</B></FONT><BR/><FONT POINT-SIZE="9">Runs separately from the agent,<BR/>reads the protected agent<BR/>environment, and starts or...</FONT><BR/><FONT POINT-SIZE="8"><I>Joined device</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Lite agent supervisor. Runs separately from the agent, reads the protected agent environment, and starts or restarts failed agents without overwriting identity.", URL="../../../../generated/production/architecture/components/agent-supervisor/", target="_top"];
    "agent-signals" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Heartbeat, telemetry,<BR/>and health publishers</B></FONT><BR/><FONT POINT-SIZE="9">Publish fresh runtime signals used<BR/>to derive Online, Offline, Stale,<BR/>Agent stopped, and Remote access...</FONT><BR/><FONT POINT-SIZE="8"><I>Node agent</I></FONT><BR/><FONT POINT-SIZE="7.5">Event</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled", fillcolor="#fce7f3", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Heartbeat, telemetry, and health publishers. Publish fresh runtime signals used to derive Online, Offline, Stale, Agent stopped, and Remote access not ready states.", URL="../../../../generated/production/architecture/components/agent-signals/", target="_top"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "completion-evidence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Completion and audit<BR/>evidence</B></FONT><BR/><FONT POINT-SIZE="9">Records sanitized lifecycle and<BR/>completion evidence for commands,<BR/>devices, apps, security, recovery,...</FONT><BR/><FONT POINT-SIZE="8"><I>Worker and FastAPI</I></FONT><BR/><FONT POINT-SIZE="7.5">Event</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled", fillcolor="#fce7f3", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Completion and audit evidence. Records sanitized lifecycle and completion evidence for commands, devices, apps, security, recovery, and releases.", URL="../../../../generated/production/architecture/components/completion-evidence/", target="_top"];
    "nats-jetstream" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>NATS / JetStream</B></FONT><BR/><FONT POINT-SIZE="9">Provides the command and event<BR/>backbone with durable delivery; it<BR/>is never contacted directly by the...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host</I></FONT><BR/><FONT POINT-SIZE="7.5">Event</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled", fillcolor="#fce7f3", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="NATS / JetStream. Provides the command and event backbone with durable delivery; it is never contacted directly by the frontend.", URL="../../../../generated/production/architecture/components/nats-jetstream/", target="_top"];
  }
  subgraph "cluster_server-host" {
    label="Server-host boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "pm2" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>PM2 process manager</B></FONT><BR/><FONT POINT-SIZE="9">Starts and supervises approved<BR/>server-host and joined-device<BR/>processes with bounded restart...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host and joined<BR/>devices</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="PM2 process manager. Starts and supervises approved server-host and joined-device processes with bounded restart policies.", URL="../../../../generated/production/architecture/components/pm2/", target="_top"];
  }
  "node-agent" -> "agent-signals" [label="publishes", tooltip="publishes (NATS)", style="dashed", arrowhead="normal", color="#047857", fontcolor="#047857"];
  "lite-api" -> "api-guards" [label="validates identity and intent", tooltip="validates identity and intent (Python)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
  "api-guards" -> "node-agent" [label="backend-generated bootstrap", tooltip="backend-generated bootstrap (Shell artifact)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
  "invite-state" -> "device-state" [label="accepted enrollment", tooltip="accepted enrollment (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "nats-jetstream" -> "device-state" [label="fleet events projected", tooltip="fleet events projected (NATS/SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "pm2" -> "node-agent" [label="starts/supervises", tooltip="starts/supervises (Local process)", style="dashed", arrowhead="vee", color="#b45309", fontcolor="#b45309"];
  "pm2" -> "agent-supervisor" [label="starts/supervises", tooltip="starts/supervises (Local process)", style="dashed", arrowhead="vee", color="#b45309", fontcolor="#b45309"];
  "agent-signals" -> "nats-jetstream" [label="heartbeat/telemetry/health", tooltip="heartbeat/telemetry/health (NATS)", style="dashed", arrowhead="normal", color="#047857", fontcolor="#047857"];
  "api-guards" -> "invite-state" [label="stores invite/identity state", tooltip="stores invite/identity state (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "agent-signals" -> "device-state" [label="updates device truth", tooltip="updates device truth (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
}
