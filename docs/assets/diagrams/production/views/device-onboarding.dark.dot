digraph device_onboarding {
  graph [
    rankdir="LR",
    splines="polyline",
    compound="true",
    newrank="true",
    nodesep="0.40",
    ranksep="0.72",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#0f172a",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="Device onboarding",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#94a3b8",
    fontcolor="#f8fafc",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#94a3b8",
    fontcolor="#cbd5e1",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_browser" {
    label="Browser trust boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "pwa" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__pwa" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>React / Vite PWA</B></FONT><BR/><FONT POINT-SIZE="9">Renders Lite screens and sends<BR/>same-origin requests only to...</FONT><BR/><FONT POINT-SIZE="8"><I>Browser / installed PWA</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#0c4a6e", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="React / Vite PWA. Renders Lite screens and sends same-origin requests only to FastAPI through Caddy.", URL="../../../../generated/production/architecture/components/pwa/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_control-api" {
    label="Control API boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "lite-api" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__lite-api" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>FastAPI /api/lite/*</B></FONT><BR/><FONT POINT-SIZE="9">Validates requests, owns safe read<BR/>APIs, admits commands, and never...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host · PM2</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#312e81", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="FastAPI /api/lite/*. Validates requests, owns safe read APIs, admits commands, and never delegates browser execution directly to NATS or shell.", URL="../../../../generated/production/architecture/components/lite-api/", target="_top", margin="0.10,0.08"];
    "api-guards" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__api-guards" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Identity, authentication,<BR/>and invite guards</B></FONT><BR/><FONT POINT-SIZE="9">Applies identity guards, duplicate<BR/>checks, protected-host checks, and...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI process · pocket-api</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#312e81", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Identity, authentication, and invite guards. Applies identity guards, duplicate checks, protected-host checks, and fail-closed invite/bootstrap acceptance.", URL="../../../../generated/production/architecture/components/api-guards/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_durable-state" {
    label="Durable-state boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "invite-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__invite-state" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Invite and identity<BR/>lifecycle</B></FONT><BR/><FONT POINT-SIZE="9">Tracks pending, accepted, revoked,<BR/>blocked, and consumed...</FONT><BR/><FONT POINT-SIZE="8"><I>SQLite · Lite API</I></FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Invite and identity lifecycle. Tracks pending, accepted, revoked, blocked, and consumed invite/identity state with duplicate and mismatch guards.", URL="../../../../generated/production/architecture/components/invite-state/", target="_top", margin="0.10,0.08"];
    "device-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__device-state" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Enrollment and device<BR/>lifecycle state</B></FONT><BR/><FONT POINT-SIZE="9">Retains enrolled devices across<BR/>connectivity loss and separates...</FONT><BR/><FONT POINT-SIZE="8"><I>SQLite · lite_control_plane_store</I></FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Enrollment and device lifecycle state. Retains enrolled devices across connectivity loss and separates durable enrollment, current state, health, supervisor state, and recovery history.", URL="../../../../generated/production/architecture/components/device-state/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_managed-device" {
    label="Managed-device boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "node-agent" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__node-agent" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Lite node agent</B></FONT><BR/><FONT POINT-SIZE="9">Connects to NATS, publishes<BR/>heartbeat/telemetry/health,...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host or joined device · PM2</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Lite node agent. Connects to NATS, publishes heartbeat/telemetry/health, handles device commands, and reconnects after outages.", URL="../../../../generated/production/architecture/components/node-agent/", target="_top", margin="0.10,0.08"];
    "agent-supervisor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__agent-supervisor" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Lite agent supervisor</B></FONT><BR/><FONT POINT-SIZE="9">Runs separately from the agent,<BR/>reads the protected agent...</FONT><BR/><FONT POINT-SIZE="8"><I>Joined device · PM2</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Lite agent supervisor. Runs separately from the agent, reads the protected agent environment, and starts or restarts failed agents without overwriting identity.", URL="../../../../generated/production/architecture/components/agent-supervisor/", target="_top", margin="0.10,0.08"];
    "agent-signals" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__agent-signals" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Heartbeat, telemetry, and<BR/>health publishers</B></FONT><BR/><FONT POINT-SIZE="9">Publish fresh runtime signals used<BR/>to derive Online, Offline, Stale,...</FONT><BR/><FONT POINT-SIZE="8"><I>Node agent · node agent</I></FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#831843", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Heartbeat, telemetry, and health publishers. Publish fresh runtime signals used to derive Online, Offline, Stale, Agent stopped, and Remote access not ready states.", URL="../../../../generated/production/architecture/components/agent-signals/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "completion-evidence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__completion-evidence" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Completion and audit<BR/>evidence</B></FONT><BR/><FONT POINT-SIZE="9">Records sanitized lifecycle and<BR/>completion evidence for commands,...</FONT><BR/><FONT POINT-SIZE="8"><I>Worker and FastAPI · worker / FastAPI</I></FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#831843", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Completion and audit evidence. Records sanitized lifecycle and completion evidence for commands, devices, apps, security, recovery, and releases.", URL="../../../../generated/production/architecture/components/completion-evidence/", target="_top", margin="0.10,0.08"];
    "nats-jetstream" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__nats-jetstream" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>NATS / JetStream</B></FONT><BR/><FONT POINT-SIZE="9">Provides the command and event<BR/>backbone with durable delivery; it...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host · PM2</I></FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#831843", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="NATS / JetStream. Provides the command and event backbone with durable delivery; it is never contacted directly by the frontend.", URL="../../../../generated/production/architecture/components/nats-jetstream/", target="_top", margin="0.10,0.08"];
  }
  subgraph "cluster_server-host" {
    label="Server-host boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "pm2" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__pm2" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>PM2 process manager</B></FONT><BR/><FONT POINT-SIZE="9">Starts and supervises approved<BR/>server-host and joined-device...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host and joined<BR/>devices · PM2</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="PM2 process manager. Starts and supervises approved server-host and joined-device processes with bounded restart policies.", URL="../../../../generated/production/architecture/components/pm2/", target="_top", margin="0.10,0.08"];
  }
  "node-agent" -> "agent-signals" [label="publishes", tooltip="publishes (NATS)", style="dashed", arrowhead="normal", color="#6ee7b7", fontcolor="#6ee7b7", penwidth="1.15", arrowsize="0.72"];
  "lite-api" -> "api-guards" [label="validates identity and intent", tooltip="validates identity and intent (Python)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "api-guards" -> "node-agent" [label="backend-generated bootstrap", tooltip="backend-generated bootstrap (Shell artifact)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "invite-state" -> "device-state" [label="accepted enrollment", tooltip="accepted enrollment (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
  "nats-jetstream" -> "device-state" [label="fleet events projected", tooltip="fleet events projected (NATS/SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
  "pm2" -> "node-agent" [label="starts/supervises", tooltip="starts/supervises (Local process)", style="dashed", arrowhead="vee", color="#fbbf24", fontcolor="#fbbf24", penwidth="1.15", arrowsize="0.72"];
  "pm2" -> "agent-supervisor" [label="starts/supervises", tooltip="starts/supervises (Local process)", style="dashed", arrowhead="vee", color="#fbbf24", fontcolor="#fbbf24", penwidth="1.15", arrowsize="0.72"];
  "agent-signals" -> "nats-jetstream" [label="heartbeat/telemetry/health", tooltip="heartbeat/telemetry/health (NATS)", style="dashed", arrowhead="normal", color="#6ee7b7", fontcolor="#6ee7b7", penwidth="1.15", arrowsize="0.72"];
  "api-guards" -> "invite-state" [label="stores invite/identity state", tooltip="stores invite/identity state (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
  "agent-signals" -> "device-state" [label="updates device truth", tooltip="updates device truth (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
}
