digraph security {
  graph [
    rankdir="TB",
    splines="spline",
    compound="true",
    newrank="true",
    nodesep="0.34",
    ranksep="0.58",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#ffffff",
    fontcolor="#172033",
    fontname="Arial",
    label="Security and safety",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#64748b",
    fontcolor="#172033",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#64748b",
    fontcolor="#475569",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_browser" {
    label="Browser trust boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "pwa" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>React / Vite PWA</B></FONT><BR/><FONT POINT-SIZE="9">Renders Lite screens and sends<BR/>same-origin requests only to<BR/>FastAPI through Caddy.</FONT><BR/><FONT POINT-SIZE="8"><I>Browser / installed PWA</I></FONT><BR/><FONT POINT-SIZE="7.5">Ui</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e0f2fe", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="React / Vite PWA. Renders Lite screens and sends same-origin requests only to FastAPI through Caddy.", URL="../../../../generated/production/architecture/components/pwa/", target="_top"];
  }
  subgraph "cluster_control-api" {
    label="Control API boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "api-domain-surfaces" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Fleet, Apps, Security,<BR/>Recovery, and Release...</B></FONT><BR/><FONT POINT-SIZE="9">Exposes domain-specific read and<BR/>command endpoints while preserving<BR/>backend-owned lifecycle execution.</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI process</I></FONT><BR/><FONT POINT-SIZE="7.5">Service</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e0e7ff", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Fleet, Apps, Security, Recovery, and Release APIs. Exposes domain-specific read and command endpoints while preserving backend-owned lifecycle execution.", URL="../../../../generated/production/architecture/components/api-domain-surfaces/", target="_top"];
    "security-coordinator" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Security scan<BR/>coordinator</B></FONT><BR/><FONT POINT-SIZE="9">Validates Quick, Full, and App<BR/>Check requests, tracks active<BR/>runs, and exposes compact...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI and worker</I></FONT><BR/><FONT POINT-SIZE="7.5">Service</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e0e7ff", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Security scan coordinator. Validates Quick, Full, and App Check requests, tracks active runs, and exposes compact split-read summaries.", URL="../../../../generated/production/architecture/components/security-coordinator/", target="_top"];
    "api-read-surfaces" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Prepared read, health,<BR/>readiness,...</B></FONT><BR/><FONT POINT-SIZE="9">Serves side-effect-free prepared<BR/>projections, health/readiness,<BR/>compact diagnostics, and sanitized...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI process</I></FONT><BR/><FONT POINT-SIZE="7.5">Service</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e0e7ff", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Prepared read, health, readiness, diagnostics, and evidence APIs. Serves side-effect-free prepared projections, health/readiness, compact diagnostics, and sanitized evidence lookups.", URL="../../../../generated/production/architecture/components/api-read-surfaces/", target="_top"];
  }
  subgraph "cluster_durable-state" {
    label="Durable-state boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "security-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Security findings and<BR/>run state</B></FONT><BR/><FONT POINT-SIZE="9">Stores scan runs, tools, progress,<BR/>findings, profile snapshots, and<BR/>sanitized evidence references.</FONT><BR/><FONT POINT-SIZE="8"><I>SQLite and compact<BR/>sanitized files</I></FONT><BR/><FONT POINT-SIZE="7.5">Database</FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#fef3c7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Security findings and run state. Stores scan runs, tools, progress, findings, profile snapshots, and sanitized evidence references.", URL="../../../../generated/production/architecture/components/security-state/", target="_top"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#94a3b8";
    fillcolor="#f8fafc";
    fontcolor="#172033";
    penwidth="1.0";
    "nats-jetstream" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>NATS / JetStream</B></FONT><BR/><FONT POINT-SIZE="9">Provides the command and event<BR/>backbone with durable delivery; it<BR/>is never contacted directly by the...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host</I></FONT><BR/><FONT POINT-SIZE="7.5">Event</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled", fillcolor="#fce7f3", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="NATS / JetStream. Provides the command and event backbone with durable delivery; it is never contacted directly by the frontend.", URL="../../../../generated/production/architecture/components/nats-jetstream/", target="_top"];
    "worker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Worker process</B></FONT><BR/><FONT POINT-SIZE="9">Consumes durable commands and owns<BR/>backend execution for apps,<BR/>security, recovery, releases, and...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Worker process. Consumes durable commands and owns backend execution for apps, security, recovery, releases, and lifecycle work.", URL="../../../../generated/production/architecture/components/worker/", target="_top"];
    "security-profiles" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Quick, Full, and App<BR/>safety checks</B></FONT><BR/><FONT POINT-SIZE="9">Defines bounded profile-specific<BR/>targets, exclusions, timeouts,<BR/>coverage summaries, and truthful...</FONT><BR/><FONT POINT-SIZE="8"><I>Security worker</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Quick, Full, and App safety checks. Defines bounded profile-specific targets, exclusions, timeouts, coverage summaries, and truthful partial/failed states.", URL="../../../../generated/production/architecture/components/security-profiles/", target="_top"];
    "scanner-adapters" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Lynis and Trivy<BR/>scanner adapters</B></FONT><BR/><FONT POINT-SIZE="9">Run bounded backend-owned scanners<BR/>with target-aware exclusions and<BR/>sanitized evidence; the browser...</FONT><BR/><FONT POINT-SIZE="8"><I>Security worker<BR/>subprocesses</I></FONT><BR/><FONT POINT-SIZE="7.5">Process</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#dcfce7", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Lynis and Trivy scanner adapters. Run bounded backend-owned scanners with target-aware exclusions and sanitized evidence; the browser never executes scanners.", URL="../../../../generated/production/architecture/components/scanner-adapters/", target="_top"];
    "completion-evidence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="42" HEIGHT="42"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Completion and audit<BR/>evidence</B></FONT><BR/><FONT POINT-SIZE="9">Records sanitized lifecycle and<BR/>completion evidence for commands,<BR/>devices, apps, security, recovery,...</FONT><BR/><FONT POINT-SIZE="8"><I>Worker and FastAPI</I></FONT><BR/><FONT POINT-SIZE="7.5">Event</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled", fillcolor="#fce7f3", color="#64748b", fontcolor="#172033", penwidth="1.35", tooltip="Completion and audit evidence. Records sanitized lifecycle and completion evidence for commands, devices, apps, security, recovery, and releases.", URL="../../../../generated/production/architecture/components/completion-evidence/", target="_top"];
  }
  "api-domain-surfaces" -> "nats-jetstream" [label="publishes validated command", tooltip="publishes validated command (NATS)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
  "security-coordinator" -> "completion-evidence" [label="records sanitized lifecycle", tooltip="records sanitized lifecycle (SQLite/NATS)", style="dotted", arrowhead="normal", color="#7c3aed", fontcolor="#7c3aed"];
  "completion-evidence" -> "api-read-surfaces" [label="sanitized lookup", tooltip="sanitized lookup (HTTP)", style="dotted", arrowhead="normal", color="#7c3aed", fontcolor="#7c3aed"];
  "nats-jetstream" -> "worker" [label="durable delivery", tooltip="durable delivery (JetStream)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
  "security-profiles" -> "scanner-adapters" [label="defines targets/exclusions", tooltip="defines targets/exclusions (Python)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
  "scanner-adapters" -> "security-state" [label="writes normalized results", tooltip="writes normalized results (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "security-coordinator" -> "security-profiles" [label="selects Quick/Full/App", tooltip="selects Quick/Full/App (Python)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
  "security-coordinator" -> "scanner-adapters" [label="runs bounded plan", tooltip="runs bounded plan (Subprocess)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
  "security-coordinator" -> "security-state" [label="updates scan state", tooltip="updates scan state (SQLite)", style="solid", arrowhead="normal", color="#2563eb", fontcolor="#2563eb"];
  "worker" -> "security-coordinator" [label="runs security work", tooltip="runs security work (Python)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569"];
}
