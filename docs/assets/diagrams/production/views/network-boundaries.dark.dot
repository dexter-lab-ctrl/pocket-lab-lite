digraph network_boundaries {
  graph [
    rankdir="LR",
    splines="ortho",
    compound="true",
    newrank="true",
    nodesep="0.38",
    ranksep="0.72",
    pad="0.25",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#0f172a",
    fontcolor="#f8fafc",
    fontname="Arial",
    label="Network and trust boundaries",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#94a3b8",
    fontcolor="#f8fafc",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#94a3b8",
    fontcolor="#cbd5e1",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_application-container" {
    label="Application-container boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "photoprism" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>PhotoPrism</B></FONT><BR/><FONT POINT-SIZE="9">Provides the verified managed photo application under a same-origin Caddy path.</FONT><BR/><FONT POINT-SIZE="8">PROot Ubuntu on server host</FONT></TD></TR></TABLE>>, shape="ellipse", style="rounded,filled", fillcolor="#701a75", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="PhotoPrism. Provides the verified managed photo application under a same-origin Caddy path.", URL="../../../../generated/production/architecture/components/photoprism/", target="_top"];
  }
  subgraph "cluster_browser" {
    label="Browser trust boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "browser" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Browser</B></FONT><BR/><FONT POINT-SIZE="9">Hosts the installed or web PWA and enforces browser-origin boundaries.</FONT><BR/><FONT POINT-SIZE="8">User device</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#0c4a6e", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="Browser. Hosts the installed or web PWA and enforces browser-origin boundaries.", URL="../../../../generated/production/architecture/components/browser/", target="_top"];
    "pwa" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>React / Vite PWA</B></FONT><BR/><FONT POINT-SIZE="9">Renders Lite screens and sends same-origin requests only to FastAPI through Caddy.</FONT><BR/><FONT POINT-SIZE="8">Browser / installed PWA</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#0c4a6e", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="React / Vite PWA. Renders Lite screens and sends same-origin requests only to FastAPI through Caddy.", URL="../../../../generated/production/architecture/components/pwa/", target="_top"];
  }
  subgraph "cluster_control-api" {
    label="Control API boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "lite-api" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>FastAPI /api/lite/*</B></FONT><BR/><FONT POINT-SIZE="9">Validates requests, owns safe read APIs, admits commands, and never delegates browser...</FONT><BR/><FONT POINT-SIZE="8">Server host</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#312e81", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="FastAPI /api/lite/*. Validates requests, owns safe read APIs, admits commands, and never delegates browser execution directly to NATS or shell.", URL="../../../../generated/production/architecture/components/lite-api/", target="_top"];
    "remote-readiness" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Remote-access readiness checks</B></FONT><BR/><FONT POINT-SIZE="9">Combines tailscaled state, Tailnet IPv4, NATS listener reachability, agent/supervisor...</FONT><BR/><FONT POINT-SIZE="8">FastAPI read surface</FONT></TD></TR></TABLE>>, shape="diamond", style="rounded,filled", fillcolor="#7f1d1d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="Remote-access readiness checks. Combines tailscaled state, Tailnet IPv4, NATS listener reachability, agent/supervisor status, and safe guidance.", URL="../../../../generated/production/architecture/components/remote-readiness/", target="_top"];
  }
  subgraph "cluster_external-release" {
    label="External release boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "github-release" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>GitHub Release</B></FONT><BR/><FONT POINT-SIZE="9">Publishes the verified Lite release manifest, checksums, and dist.zip assets for the...</FONT><BR/><FONT POINT-SIZE="8">GitHub</FONT></TD></TR></TABLE>>, shape="ellipse", style="rounded,filled", fillcolor="#581c87", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="GitHub Release. Publishes the verified Lite release manifest, checksums, and dist.zip assets for the release subprocess.", URL="../../../../generated/production/architecture/components/github-release/", target="_top"];
  }
  subgraph "cluster_managed-device" {
    label="Managed-device boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "node-agent" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Lite node agent</B></FONT><BR/><FONT POINT-SIZE="9">Connects to NATS, publishes heartbeat/telemetry/health, handles device commands, and...</FONT><BR/><FONT POINT-SIZE="8">Server host or joined device</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="Lite node agent. Connects to NATS, publishes heartbeat/telemetry/health, handles device commands, and reconnects after outages.", URL="../../../../generated/production/architecture/components/node-agent/", target="_top"];
  }
  subgraph "cluster_messaging-execution" {
    label="Messaging and execution boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "nats-jetstream" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>NATS / JetStream</B></FONT><BR/><FONT POINT-SIZE="9">Provides the command and event backbone with durable delivery; it is never contacted...</FONT><BR/><FONT POINT-SIZE="8">Server host</FONT></TD></TR></TABLE>>, shape="parallelogram", style="rounded,filled", fillcolor="#831843", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="NATS / JetStream. Provides the command and event backbone with durable delivery; it is never contacted directly by the frontend.", URL="../../../../generated/production/architecture/components/nats-jetstream/", target="_top"];
  }
  subgraph "cluster_server-host" {
    label="Server-host boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "tailscaled" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>tailscaled daemon</B></FONT><BR/><FONT POINT-SIZE="9">Owns Tailscale networking; startup scripts may detect/start it safely while read APIs...</FONT><BR/><FONT POINT-SIZE="8">Android/Termux server host</FONT></TD></TR></TABLE>>, shape="component", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="tailscaled daemon. Owns Tailscale networking; startup scripts may detect/start it safely while read APIs remain side-effect-free.", URL="../../../../generated/production/architecture/components/tailscaled/", target="_top"];
    "caddy" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Caddy same-origin proxy</B></FONT><BR/><FONT POINT-SIZE="9">Serves the PWA and routes /api/lite/* and managed app paths without exposing backend...</FONT><BR/><FONT POINT-SIZE="8">Server host</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#4c1d95", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="Caddy same-origin proxy. Serves the PWA and routes /api/lite/* and managed app paths without exposing backend secrets.", URL="../../../../generated/production/architecture/components/caddy/", target="_top"];
    "nats-listeners" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Primary and secondary NATS listeners</B></FONT><BR/><FONT POINT-SIZE="9">Exposes local and verified Tailnet-reachable NATS listeners for agents without hardco...</FONT><BR/><FONT POINT-SIZE="8">Server host</FONT></TD></TR></TABLE>>, shape="hexagon", style="rounded,filled", fillcolor="#155e75", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="Primary and secondary NATS listeners. Exposes local and verified Tailnet-reachable NATS listeners for agents without hardcoding credentials or addresses.", URL="../../../../generated/production/architecture/components/nats-listeners/", target="_top"];
  }
  subgraph "cluster_tailnet" {
    label="Private network and Tailnet boundary";
    style="rounded,dashed,filled";
    color="#64748b";
    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "lan" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Local LAN</B></FONT><BR/><FONT POINT-SIZE="9">Provides local-device access to the same-origin Caddy endpoint without hardcoded addr...</FONT><BR/><FONT POINT-SIZE="8">Private local network</FONT></TD></TR></TABLE>>, shape="hexagon", style="rounded,filled", fillcolor="#155e75", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="Local LAN. Provides local-device access to the same-origin Caddy endpoint without hardcoded addresses.", URL="../../../../generated/production/architecture/components/lan/", target="_top"];
    "tailscale" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD FIXEDSIZE="TRUE" WIDTH="38" HEIGHT="38"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12"><B>Tailscale remote access</B></FONT><BR/><FONT POINT-SIZE="9">Provides private Tailnet connectivity and HTTPS identity without becoming a browser-h...</FONT><BR/><FONT POINT-SIZE="8">Server host and joined devices</FONT></TD></TR></TABLE>>, shape="hexagon", style="rounded,filled", fillcolor="#155e75", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.15", tooltip="Tailscale remote access. Provides private Tailnet connectivity and HTTPS identity without becoming a browser-held secret or control owner.", URL="../../../../generated/production/architecture/components/tailscale/", target="_top"];
  }
  "browser" -> "pwa" [label="loads and hosts", tooltip="loads and hosts (Browser runtime)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "caddy" -> "lite-api" [label="routes /api/lite/*", tooltip="routes /api/lite/* (HTTP)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "caddy" -> "photoprism" [label="same-origin /apps path", tooltip="same-origin /apps path (HTTP)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "lan" -> "caddy" [label="local HTTPS", tooltip="local HTTPS (HTTPS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "nats-listeners" -> "nats-jetstream" [label="listener endpoints", tooltip="listener endpoints (NATS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "pwa" -> "caddy" [label="same-origin request", tooltip="same-origin request (HTTPS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "tailscaled" -> "remote-readiness" [label="daemon status", tooltip="daemon status (Local status)", style="dashed", arrowhead="normal", color="#6ee7b7", fontcolor="#6ee7b7"];
  "nats-listeners" -> "remote-readiness" [label="listener reachability", tooltip="listener reachability (TCP)", style="dashed", arrowhead="normal", color="#6ee7b7", fontcolor="#6ee7b7"];
  "tailscale" -> "caddy" [label="Tailnet HTTPS", tooltip="Tailnet HTTPS (HTTPS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "tailscale" -> "nats-listeners" [label="Tailnet reachability", tooltip="Tailnet reachability (TCP)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1"];
  "tailscaled" -> "tailscale" [label="provides interface", tooltip="provides interface (Tailscale)", style="dashed", arrowhead="normal", color="#6ee7b7", fontcolor="#6ee7b7"];
}
