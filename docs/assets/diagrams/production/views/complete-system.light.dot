digraph complete_system {
  graph [
    rankdir="LR",
    splines="spline",
    compound="true",
    newrank="true",
    nodesep="0.34",
    ranksep="0.78",
    ratio="compress",
    pad="0.20",
    margin="0",
    outputorder="edgesfirst",
    bgcolor="#ffffff",
    fontcolor="#172033",
    fontname="Arial",
    label="Complete Pocket Lab Lite system map",
    labelloc="t",
    fontsize="20"
  ];
  node [
    fontname="Arial",
    fontsize="10",
    color="#64748b",
    fontcolor="#172033",
    margin="0.12,0.08"
  ];
  edge [
    fontname="Arial",
    fontsize="8",
    color="#64748b",
    fontcolor="#475569",
    arrowsize="0.72",
    penwidth="1.15"
  ];
  subgraph "cluster_zone_experience" {
    label="Zone A — Experience";
    style="rounded,filled,bold";
