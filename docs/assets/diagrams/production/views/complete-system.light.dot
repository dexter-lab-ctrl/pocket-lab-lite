  "browser" -> "pwa" [label="1 · loads and hosts", tooltip="1. User/API request: loads and hosts (Browser runtime)", style="solid", arrowhead="normal", color="#475569", fontcolor="#475569", penwidth="2.8", arrowsize="0.92"];
