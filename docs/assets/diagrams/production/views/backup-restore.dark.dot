    "worker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__worker" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Worker process</B></FONT><BR/><FONT POINT-SIZE="9">Consumes durable commands and owns<BR/>backend execution for apps,...</FONT><BR/><FONT POINT-SIZE="8"><I>Server host · PM2</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Worker process. Consumes durable commands and owns backend execution for apps, security, recovery, releases, and lifecycle work.", URL="../../../../generated/production/architecture/components/worker/", target="_top", margin="0.10,0.08"];
    "backup-engine" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__backup-engine" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Backup and verification<BR/>engine</B></FONT><BR/><FONT POINT-SIZE="9">Creates and verifies local<BR/>encrypted backups through...</FONT><BR/><FONT POINT-SIZE="8"><I>Recovery worker · pocket-worker</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Backup and verification engine. Creates and verifies local encrypted backups through backend/worker-owned operations.", URL="../../../../generated/production/architecture/components/backup-engine/", target="_top", margin="0.10,0.08"];
    "restore-preview" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__restore-preview" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Restore preview and<BR/>confirmed restore</B></FONT><BR/><FONT POINT-SIZE="9">Builds a non-destructive preview,<BR/>requires explicit confirmation,...</FONT><BR/><FONT POINT-SIZE="8"><I>Recovery worker · pocket-worker</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Restore preview and confirmed restore. Builds a non-destructive preview, requires explicit confirmation, creates a checkpoint, applies restore, and validates health.", URL="../../../../generated/production/architecture/components/restore-preview/", target="_top", margin="0.10,0.08"];
    "checkpoints-retention" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__checkpoints-retention" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Checkpoints and retention<BR/>policy</B></FONT><BR/><FONT POINT-SIZE="9">Creates pre-change checkpoints and<BR/>applies explicit bounded retention...</FONT><BR/><FONT POINT-SIZE="8"><I>Recovery worker · pocket-worker</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Checkpoints and retention policy. Creates pre-change checkpoints and applies explicit bounded retention without silently deleting current state.", URL="../../../../generated/production/architecture/components/checkpoints-retention/", target="_top", margin="0.10,0.08"];
    "retirement-database-recovery" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__retirement-database-recovery" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Explicit retirement and<BR/>database recovery</B></FONT><BR/><FONT POINT-SIZE="9">Requires assessment and<BR/>confirmation for device retirement...</FONT><BR/><FONT POINT-SIZE="8"><I>FastAPI / worker · pocket-api /...</I></FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#14532d", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Explicit retirement and database recovery. Requires assessment and confirmation for device retirement and provides verified database backup/preview/restore without coupling command cleanup to device deletion.", URL="../../../../generated/production/architecture/components/retirement-database-recovery/", target="_top", margin="0.10,0.08"];
    "completion-evidence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__completion-evidence" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Completion and audit<BR/>evidence</B></FONT><BR/><FONT POINT-SIZE="9">Records sanitized lifecycle and<BR/>completion evidence for commands,...</FONT><BR/><FONT POINT-SIZE="8"><I>Worker and FastAPI · worker / FastAPI</I></FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#831843", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Completion and audit evidence. Records sanitized lifecycle and completion evidence for commands, devices, apps, security, recovery, and releases.", URL="../../../../generated/production/architecture/components/completion-evidence/", target="_top", margin="0.10,0.08"];
  }
  "api-domain-surfaces" -> "nats-jetstream" [label="publishes validated command", tooltip="publishes validated command (NATS)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "backup-engine" -> "restore-preview" [label="verified backup input", tooltip="verified backup input (Manifest)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "retirement-database-recovery" -> "sqlite" [label="verified backup/restore", tooltip="verified backup/restore (SQLite/filesystem)", style="dashed", arrowhead="vee", color="#fbbf24", fontcolor="#fbbf24", penwidth="1.15", arrowsize="0.72"];
  "backup-engine" -> "completion-evidence" [label="records sanitized lifecycle", tooltip="records sanitized lifecycle (SQLite/NATS)", style="dotted", arrowhead="normal", color="#c4b5fd", fontcolor="#c4b5fd", penwidth="1.15", arrowsize="0.72"];
  "nats-jetstream" -> "worker" [label="durable delivery", tooltip="durable delivery (JetStream)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
  "restore-preview" -> "checkpoints-retention" [label="creates checkpoint before apply", tooltip="creates checkpoint before apply (NATS)", style="dashed", arrowhead="vee", color="#fbbf24", fontcolor="#fbbf24", penwidth="1.15", arrowsize="0.72"];
  "checkpoints-retention" -> "retirement-database-recovery" [label="provides recovery point", tooltip="provides recovery point (SQLite)", style="dashed", arrowhead="vee", color="#fbbf24", fontcolor="#fbbf24", penwidth="1.15", arrowsize="0.72"];
  "recovery-state" -> "sqlite" [label="stored in", tooltip="stored in (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
  "backup-engine" -> "recovery-state" [label="updates backup state", tooltip="updates backup state (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
  "restore-preview" -> "recovery-state" [label="updates restore state", tooltip="updates restore state (SQLite)", style="solid", arrowhead="normal", color="#60a5fa", fontcolor="#60a5fa", penwidth="1.15", arrowsize="0.72"];
  "worker" -> "backup-engine" [label="runs backup work", tooltip="runs backup work (Python)", style="solid", arrowhead="normal", color="#cbd5e1", fontcolor="#cbd5e1", penwidth="1.15", arrowsize="0.72"];
