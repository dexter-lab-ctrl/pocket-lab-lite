    fillcolor="#111827";
    fontcolor="#f8fafc";
    penwidth="1.0";
    "recovery-state" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD FIXEDSIZE="TRUE" WIDTH="58" HEIGHT="64" ALIGN="CENTER" VALIGN="MIDDLE" BORDER="1" BGCOLOR="#FFFFFF" HREF="#PLICON__recovery-state" TITLE="Architecture icon anchor"><FONT POINT-SIZE="1">&#160;</FONT></TD><TD WIDTH="188" ALIGN="LEFT" BALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="13"><B>Backup, restore, and<BR/>checkpoint state</B></FONT><BR/><FONT POINT-SIZE="9">Stores backup manifests, recovery<BR/>operations, current state,...</FONT><BR/><FONT POINT-SIZE="8"><I>SQLite and repository-owned<BR/>manifests · Recovery worker</I></FONT></TD></TR></TABLE>>, shape="cylinder", style="rounded,filled", fillcolor="#78350f", color="#94a3b8", fontcolor="#f8fafc", penwidth="1.25", tooltip="Backup, restore, and checkpoint state. Stores backup manifests, recovery operations, current state, database backups/restores, and restore checkpoints.", URL="../../../../generated/production/architecture/components/recovery-state/", target="_top", margin="0.10,0.08"];
