{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketlab.invalid/schemas/parity/parity-contract.schema.json",
  "title": "Generated Pocket Lab Lite parity contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "source_revision", "semantic_fingerprint", "status", "items"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 80},
    "semantic_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "maxLength": 64},
    "items": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "required": ["id"],
        "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,119}$"}},
        "additionalProperties": true
      }
    }
  }
}
