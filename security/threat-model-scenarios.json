{
  "schema_version": "1.0.0",
  "framework": {
    "primary": "STRIDE",
    "reference_mappings": ["OWASP Top 10 where applicable"],
    "application": [
      "Identify canonical trust boundaries, assets, actors and flows.",
      "Generate STRIDE candidates for every trust boundary.",
      "Map repository-owned controls to applicable threat categories and boundaries.",
      "Attach promoted runtime, security, release and dependency evidence to control posture.",
      "Require human review for threat relevance, mitigation adequacy, residual risk, risk acceptance and exceptions."
    ],
    "definitions": {
      "Spoofing": "Impersonating a user, device, service or release identity.",
      "Tampering": "Unauthorized modification of commands, durable state, releases or evidence.",
      "Repudiation": "Loss of trustworthy evidence about who or what performed an action.",
      "Information Disclosure": "Exposure of secrets, private paths, credentials or sensitive operational metadata.",
      "Denial of Service": "Loss of availability, command delivery or recovery capability.",
      "Elevation of Privilege": "Bypassing browser, control API, execution-owner or host boundaries."
    }
  },
  "truth_layers": [
    {"id": "threat-model", "question": "What could go wrong?", "authority": "canonical architecture and security source"},
    {"id": "control-posture", "question": "Which mitigations currently have evidence?", "authority": "source plus promoted evidence"},
    {"id": "operational-posture", "question": "What does the latest promoted evidence report?", "authority": "promoted sanitized runtime/security/release evidence"}
  ],
  "exclusions": [
    "Live attack monitoring or packet inspection",
    "Live NATS polling or traffic visualization",
    "Running Trivy, Lynis, Semgrep or other scanners from MkDocs",
    "Scanning the live Android filesystem from documentation generation",
    "Automatically deciding whether a vulnerability is exploitable",
    "Automatically accepting residual risk or security exceptions",
    "Replacing penetration testing, source review or operational monitoring",
    "Replacing incident detection, release qualification or runtime health checks"
  ],
  "consequences_without_model": [
    "Trust assumptions become implicit and easier to violate during change.",
    "Controls can exist without a clear statement of which threats and assets they protect.",
    "Runtime, release and supply-chain evidence become disconnected from security reasoning.",
    "Boundary changes can ship without exposing their security-review impact.",
    "Duplicated, missing or weakly evidenced controls are harder to identify.",
    "Residual risk and human-review decisions become less auditable."
  ],
  "attack_paths": [
    {
      "id": "AP-01", "name": "Browser control-plane bypass", "entry_point": "browser", "target": "nats-jetstream",
      "path_nodes": ["browser", "nats-jetstream", "worker"],
      "boundaries": ["browser", "messaging-execution"],
      "stride": ["Spoofing", "Tampering", "Elevation of Privilege"],
      "controls": ["CTRL-BROWSER-NATS", "CTRL-API-CONTROL"],
      "consequences": ["unauthorized command injection", "control-plane bypass", "loss of expected audit/control ownership"],
      "status": "modeled", "review_status": "human-review-required"
    },
    {
      "id": "AP-02", "name": "Browser shell execution", "entry_point": "browser", "target": "server-host",
      "path_nodes": ["browser", "lite-api", "server-host"],
      "boundaries": ["browser", "control-api", "server-host"],
      "stride": ["Tampering", "Elevation of Privilege"],
      "controls": ["CTRL-BROWSER-SHELL", "CTRL-API-CONTROL"],
      "consequences": ["host mutation", "secret exposure", "runtime integrity loss"],
      "status": "modeled", "review_status": "human-review-required"
    },
    {
      "id": "AP-03", "name": "Forged managed-device identity", "entry_point": "managed-device", "target": "node-agent",
