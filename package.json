{
  "name": "pocket-lab-lite",
  "version": "1.0.0",
  "description": "Lightweight Pocket Lab for low-power Android/Termux and edge devices",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=mocked-desktop --project=mocked-mobile",
    "typecheck": "tsc --noEmit --allowJs --checkJs false || true",
    "format:check": "prettier --check .",
    "validate:pwa": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev:mock": "VITE_POCKETLAB_MOCKS=1 vite --host 127.0.0.1",
    "test:visual": "VITE_POCKETLAB_MOCKS=1 LITE_E2E_MODE=mocked playwright test tests/e2e/lite-visual.spec.ts --project=mocked-desktop --project=mocked-mobile",
    "test:a11y": "VITE_POCKETLAB_MOCKS=1 LITE_E2E_MODE=mocked playwright test tests/e2e/lite-accessibility.spec.ts --project=mocked-desktop --project=mocked-mobile",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "lighthouse": "lhci autorun",
    "test:n1n2": "vitest run src/lite/liteNavigationRuntime.test.js",
    "check:bundle": "node scripts/dev/check-lite-bundle-budgets.mjs",
    "build:budget": "npm run build && npm run check:bundle",
    "test:n3n6a": "vitest run src/lib/liteVirtualization.test.js src/lib/liteOfflineReadPolicy.test.js src/lib/liteServiceWorkerRuntime.test.js",
    "test:n4n5": "vitest run src/lib/liteRevisionSync.test.js",
    "test:n6b": "vitest run src/lib/liteNativeInstall.test.js src/lib/liteServiceWorkerRuntime.test.js src/lite/liteNavigationRuntime.test.js src/lib/liteOfflineReadPolicy.test.js",
    "test:premium-tabs": "vitest run src/lib/liteHomePresentation.test.js src/lib/liteRecoveryR3R4.test.js",
    "test:unit": "vitest run",
    "test:e2e:mocked": "bash scripts/dev/lite/run-playwright-mocked.sh",
    "test:e2e:live": "LITE_E2E_MODE=live playwright test tests/e2e/lite-live.spec.ts --project=live-desktop --project=live-mobile",
    "docs:contracts": "python3 scripts/docs/lite/generate_contracts.py generate",
    "docs:generate": "python3 scripts/docs/lite/generate_docs.py generate --audience all",
    "test:visual:update": "VITE_POCKETLAB_MOCKS=1 LITE_E2E_MODE=mocked playwright test tests/e2e/lite-visual.spec.ts --project=mocked-desktop --project=mocked-mobile --update-snapshots",
    "test:docs": "playwright test --config=playwright.docs.config.ts",
    "test:parity:selectors": "vitest run src/lib/liteRecoveryParity.test.js",
    "test:e2e:parity": "VITE_POCKETLAB_MOCKS=1 LITE_E2E_MODE=mocked playwright test tests/e2e/lite-parity.spec.ts --project=mocked-desktop --project=mocked-mobile"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.2",
    "@use-gesture/react": "^10.3.1",
    "@xstate/react": "^6.1.0",
    "dexie": "^4.4.4",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "xstate": "^5.32.4",
    "yaml": "^2.9.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@asyncapi/cli": "^6.0.2",
    "@asyncapi/html-template": "^3.5.6",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.46.0",
    "@redocly/cli": "^2.31.6",
    "@storybook/addon-a11y": "^8.2.0",
    "@storybook/addon-essentials": "^8.2.0",
    "@storybook/addon-interactions": "^8.2.0",
    "@storybook/react": "^8.2.0",
    "@storybook/react-vite": "^8.2.0",
    "@storybook/test": "8.6.18",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.17.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "jsonschema": "^1.4.1",
    "lighthouse": "^12.0.0",
    "mermaid": "11.16.1",
    "msw": "^2.4.0",
    "postcss": "^8.5.10",
    "prettier": "^3.3.0",
    "start-server-and-test": "^2.0.4",
    "storybook": "^8.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
