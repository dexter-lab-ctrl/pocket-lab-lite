{
  "contract": "pocket-lab-lite-operations",
  "architecture": "edge-first-fastapi-nats-agent",
  "allowed_operations": [
    "device_invite_create",
    "device_restart_agent",
    "device_remove_stale",
    "app_install",
    "app_manage",
    "security_check",
    "identity_password_change",
    "policy_evaluate",
    "backup_now",
    "restore_backup",
    "release_check",
    "release_apply",
    "health_check"
  ],
  "required_endpoints": [
    "/api/lite/status",
    "/api/lite/fleet",
    "/api/lite/security/summary",
    "/api/lite/recovery",
    "/api/lite/diagnostics/runtime"
  ],
  "required_paths": [
    "src",
    "pocket-lab-final-structure/runtime/api_fastapi",
    "pocket-lab-final-structure/runtime/core",
    "pocket-lab-final-structure/runtime/workers",
    "pocket-lab-final-structure/runtime/agents",
    "pocket-lab-final-structure/pocket-lab-bootstrap-production-scripts-patched/scripts"
  ],
  "forbidden_paths": [
    "pocket-lab-final-structure/pocket-lab-iac-api-compatible"
  ],
  "forbidden_symbols": [
    "submitLegacyOperation",
    "POCKETLAB_API_RUNTIME",
    "pocket_lab_api_server",
    "HTTPServer",
    "runtime/api/"
  ],
  "boundaries": {
    "frontend_direct_nats": false,
    "frontend_shell_execution": false,
    "frontend_backend_secrets": false,
    "control_api": "FastAPI /api/lite/*",
    "execution": "workers/agents/supervisors via NATS/JetStream",
    "same_origin_proxy": "Caddy"
  }
}
