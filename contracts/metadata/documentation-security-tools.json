      "execution_surface": "WSL2/CI and bounded existing Termux profiles",
      "expected_binary": "trivy",
      "id": "trivy",
      "install": {
        "archive": "tar.gz",
        "asset_regex": {
          "amd64": "^trivy_0\\.73\\.0_Linux-64bit\\.tar\\.gz$",
          "arm64": "^trivy_0\\.73\\.0_Linux-ARM64\\.tar\\.gz$"
        },
        "binary_path_regex": "(^|/)trivy$",
        "method": "github-release",
        "repository": "aquasecurity/trivy",
        "tag": "v0.73.0"
      },
      "license": "Apache-2.0",
      "output": "normalized security evidence",
      "platform": "WSL2/Ubuntu Linux amd64/arm64",
      "purpose": "Development SBOM/vulnerability/misconfiguration/secret correlation; existing Termux Trivy remains bounded and runtime-owned",
      "required": true,
      "required_or_optional": "required",
      "smoke_command": [
        "trivy",
        "--help"
      ],
      "source": "https://github.com/aquasecurity/trivy",
      "tool": "trivy",
      "validation_command": [
        "trivy",
        "--version"
      ],
      "version": "0.73.0"
