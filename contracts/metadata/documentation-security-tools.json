{
  "execution_policy": {
    "cache_root": "~/.cache/pocket-lab-lite/documentation-security",
    "docs_check_runs_heavy_tools": false,
    "heavy_default_surface": "WSL2/CI",
    "installation_root": ".pocketlab-dev/tools/documentation-security",
    "integrity_policy": "pinned release + SHA-256 from the official release API/checksum asset; fail closed when integrity metadata is unavailable",
    "raw_output_canonical": false,
    "termux_policy": "bounded-runtime-evidence-only",
    "upgrade_policy": "never replace a working system tool; install the reviewed pin repo-locally when the system version differs; replace a mismatched repo-local pin only when --update is explicit"
  },
  "schema_version": "2.0.0",
  "tools": [
    {
      "binary": "syft",
      "execution_surface": "WSL2/CI",
      "expected_binary": "syft",
      "id": "syft",
      "install": {
        "archive": "tar.gz",
        "asset_regex": {
          "amd64": "^syft_1\\.50\\.0_linux_amd64\\.tar\\.gz$",
          "arm64": "^syft_1\\.50\\.0_linux_arm64\\.tar\\.gz$"
        },
        "binary_path_regex": "(^|/)syft$",
        "method": "github-release",
        "repository": "anchore/syft",
        "tag": "v1.50.0"
      },
      "license": "Apache-2.0",
      "output": "CycloneDX JSON",
      "platform": "WSL2/Ubuntu Linux amd64/arm64",
      "purpose": "Primary CycloneDX SBOM generation for development and release staging",
      "required": true,
      "required_or_optional": "required",
      "smoke_command": [
        "syft",
        "help"
      ],
      "source": "https://github.com/anchore/syft",
      "tool": "syft",
      "validation_command": [
        "syft",
        "version"
      ],
      "version": "1.50.0"
    },
    {
