  "default_ui_forbidden_terms": [
    "NATS",
    "JetStream",
    "FastAPI",
    "backend",
    "control plane",
    "worker",
    "durable consumer",
    "polling policy",
    "projection stale",
    "ETag",
    "SQLite",
    "raw reason code",
    "private path",
    "command payload"
  ],
  "technical_details": {
    "default": "collapsed",
    "purpose": "safe operational facts",
    "expected_fields": [
      "checked_or_observed_time",
      "device_or_scope",
      "current_state",
      "duration_when_available",
      "change_made",
      "protected_data",
      "troubleshooting_reference_when_available"
    ],
    "prohibited": [
      "raw logs",
      "raw evidence",
      "tokens",
      "passwords",
      "api keys",
      "private keys",
      "private Android paths",
      "command payloads"
    ]
  },
  "freshness": {
